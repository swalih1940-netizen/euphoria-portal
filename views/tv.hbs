                    winners: [
                        { participant: 'Muhammed Swalih', name: 'Muhammed Swalih', rank: 1, team: 'Team Fanora' },
                        { participant: 'Muhammed Swalih', name: 'Muhammed Swalih', rank: 2, team: 'Team Fanora' },
                        { participant: 'Muhammed Swalih', name: 'Muhammed Swalih', rank: 3, team: 'Team Fanora' },
                        { participant: 'Muhammed Swalih', name: 'Muhammed Swalih', rank: 3, team: 'Team Fanora' }
                    ]
                };
            } else if (demoCycleIndex === 3) {
                // Demo 3: Prime Zone with Two 2nd Places (Essay Writing)
                demoComp = {
                    id: 'demo_' + Date.now(),
                    formattedCode: '03',
                    code: '03',
                    resultNumber: '03',
                    name: 'Essay Writing',
                    title: 'Essay Writing',
                    zone: 'PRIME ZONE',
                    zoneName: 'PRIME ZONE',
                    category: 'PRIME ZONE',
                    winners: [
                        { participant: 'Afeef Rahman', name: 'Afeef Rahman', rank: 1, team: 'Team Fanora' },
                        { participant: 'Jabir Ali', name: 'Jabir Ali', rank: 2, team: 'Team Zahora' },
                        { participant: 'Salman Faris', name: 'Salman Faris', rank: 2, team: 'Team Fanora' },
                        { participant: 'Bilal Ahmad', name: 'Bilal Ahmad', rank: 3, team: 'Team Zahora' }
                    ]
                };
            } else {
                // Demo 4: Core Zone (Elocution English)
                demoComp = {
                    id: 'demo_' + Date.now(),
                    formattedCode: '04',
                    code: '04',
                    resultNumber: '04',
                    name: 'Elocution English',
                    title: 'Elocution English',
                    zone: 'CORE ZONE',
                    zoneName: 'CORE ZONE',
                    category: 'CORE ZONE',
                    winners: [
                        { participant: 'Zayan Abdullah', name: 'Zayan Abdullah', rank: 1, team: 'Team Zahora' },
                        { participant: 'Rayan Kabeer', name: 'Rayan Kabeer', rank: 2, team: 'Team Fanora' },
                        { participant: 'Hafiz Ameen', name: 'Hafiz Ameen', rank: 3, team: 'Team Zahora' }
                    ]
                };
            }
            enqueueNotification(demoComp);
        }

        // 11. Automated Real-Time Poller (Runs every 3 seconds)
        async function pollLiveData() {
            try {
                const res = await fetch('/api/tv/live-data');
                const data = await res.json();

                if (data.success) {
                    // Update Standings & Points
                    if (data.houses) {
                        updateLeaderboardUI(data.houses);
                    }

                    // Check for immediate direct broadcast items
                    if (Array.isArray(data.broadcasts)) {
                        data.broadcasts.forEach(b => {
                            const bId = String(b.id);
                            if (!seenCompetitionIds.has(bId)) {
                                seenCompetitionIds.add(bId);
                                enqueueNotification(b);
                            }
                        });
                    }

                    // Check for newly published competitions or updated results from fest floor
                    if (Array.isArray(data.competitions)) {
                        data.competitions.forEach(comp => {
                            const compId = String(comp.id || comp._id || comp.code);
                            const winners = Array.isArray(comp.winners) ? comp.winners : (Array.isArray(comp.items) ? comp.items : []);
                            
                            if (winners.length > 0) {
                                const winnerFingerprint = `${compId}_${winners.length}_${winners.map(w => w.participant || w.name || '').join('_')}`;
                                if (!seenCompetitionIds.has(compId) && !seenResultFingerprints.has(winnerFingerprint)) {
                                    seenCompetitionIds.add(compId);
                                    seenResultFingerprints.add(winnerFingerprint);
                                    enqueueNotification(comp);
                                }
                            }
                        });
                    }
                }
            } catch (err) {
                console.warn('[TV Real-Time Poll Warning]:', err);
            }
        }

        // Initialize seen set with server-rendered competitions so they don't pop up immediately on load
        if (Array.isArray(INITIAL_COMPETITIONS)) {
            INITIAL_COMPETITIONS.forEach(c => {
                const cid = String(c.id || c._id || c.code);
                seenCompetitionIds.add(cid);
                const winners = Array.isArray(c.winners) ? c.winners : (Array.isArray(c.items) ? c.items : []);
                const fingerprint = `${cid}_${winners.length}_${winners.map(w => w.participant || w.name || '').join('_')}`;
                seenResultFingerprints.add(fingerprint);
            });
        }

        if (Array.isArray(INITIAL_HOUSES)) {
            updateLeaderboardUI(INITIAL_HOUSES);
        }

        // Start 3-second Polling Loop
        setInterval(pollLiveData, 3000);

        // Register Dedicated TV Service Worker
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw-tv.js')
                    .then(reg => console.log('[Euphoria TV SW] Registered successfully, scope:', reg.scope))
                    .catch(err => console.warn('[Euphoria TV SW] Registration skipped or failed:', err));
            });
        }

        // TV Remote & Browser Fullscreen Handlers (Key 'F', Remote OK/Enter, or double-click)
        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(e => console.log('Fullscreen request ignored:', e));
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().catch(e => console.log('Exit fullscreen ignored:', e));
                }
            }
        }

        document.addEventListener('keydown', (e) => {
            // 'f', 'F' or F11 toggles fullscreen
            if (e.key === 'f' || e.key === 'F') {
                toggleFullScreen();
            }
        });
        document.body.addEventListener('dblclick', toggleFullScreen);
    </script>

