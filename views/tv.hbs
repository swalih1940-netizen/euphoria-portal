    <!-- ============================================== -->
    <!-- JAVASCRIPT: TV ENGINE, AUDIO & REAL-TIME SYNC  -->
    <!-- ============================================== -->
    <script>
        // Global State
        let soundEnabled = true;
        let seenCompetitionIds = new Set();
        let seenResultFingerprints = new Set();
        let notificationQueue = [];
        let isPopupActive = false;
        let popupTimer = null;
        let countdownInterval = null;
        let previousFanoraPoints = 0;
        let previousZahoraPoints = 0;
        let currentPosterVariant = 1;

        // Initialize Data passed from server render
        const INITIAL_HOUSES = {{{json houses}}};
        const INITIAL_COMPETITIONS = {{{json competitions}}};

        // 1. Star Icon Helper
        function getStarSvg(colorClass = 'text-amber-300', sizeClass = 'w-5 h-5') {
            return `<svg viewBox="0 0 24 24" class="${sizeClass} fill-current ${colorClass} drop-shadow-md shrink-0" style="display:inline-block;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
        }

        function renderStarsHtml(count, colorClass = 'text-amber-300', sizeClass = 'w-5 h-5 sm:w-6 sm:h-6') {
            let out = '';
            for (let i = 0; i < count; i++) {
                out += getStarSvg(colorClass, sizeClass);
            }
            return out;
        }

        function renderPoster2StarsHtml(rank, starSize = 34, gap = 10) {
            const white = '#ffffff';
            const grey = '#475569';
            const starSvg = (fill) => `<svg viewBox="0 0 24 24" width="${starSize}" height="${starSize}" fill="${fill}" style="display:inline-block; flex-shrink: 0;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
            let stars = '';
            if (rank === 1) {
                stars = starSvg(white) + starSvg(white) + starSvg(white);
            } else if (rank === 2) {
                stars = starSvg(white) + starSvg(white) + starSvg(grey);
            } else if (rank === 3) {
                stars = starSvg(white) + starSvg(grey) + starSvg(grey);
            } else {
                stars = starSvg(grey) + starSvg(grey) + starSvg(grey);
            }
            return `<div style="display: flex; align-items: center; gap: ${gap}px;">${stars}</div>`;
        }

        // 2. Web Audio API Synthetic Chime (Crystal Fanfare Chord)
        function playChimeSound() {
            if (!soundEnabled) return;
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();

                const chordFrequencies = [523.25, 659.25, 783.99, 1046.50];
                const now = ctx.currentTime;

                chordFrequencies.forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();

                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + (idx * 0.08));

                    gain.gain.setValueAtTime(0, now + (idx * 0.08));
                    gain.gain.linearRampToValueAtTime(0.28, now + (idx * 0.08) + 0.04);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + (idx * 0.08) + 1.8);

                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    osc.start(now + (idx * 0.08));
                    osc.stop(now + (idx * 0.08) + 1.9);
                });
            } catch (err) {
                console.warn('[Web Audio Playback Warning]:', err);
            }
        }

        function toggleAudioChime() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('audio-icon');
            if (soundEnabled) {
                icon.innerText = 'volume_up';
                icon.className = 'material-symbols-outlined text-lg text-emerald-400';
                playChimeSound();
            } else {
                icon.innerText = 'volume_off';
                icon.className = 'material-symbols-outlined text-lg text-slate-500';
            }
        }

        // 3. Fullscreen Controller
        function toggleFullscreen() {
            const icon = document.getElementById('fullscreen-icon');
            if (!document.fullscreenElement) {
                if (document.documentElement.requestFullscreen) {
                    document.documentElement.requestFullscreen().catch(() => {});
                }
                icon.innerText = 'fullscreen_exit';
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen().catch(() => {});
                }
                icon.innerText = 'fullscreen';
            }
        }

        document.addEventListener('fullscreenchange', () => {
            const icon = document.getElementById('fullscreen-icon');
            if (document.fullscreenElement) {
                icon.innerText = 'fullscreen_exit';
            } else {
                icon.innerText = 'fullscreen';
            }
        });

        // Keyboard Shortcuts (F: Fullscreen, M: Mute, T: Test Popup, Escape: Dismiss)
        document.addEventListener('keydown', (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
            const key = e.key.toLowerCase();
            if (key === 'f') toggleFullscreen();
            if (key === 'm') toggleAudioChime();
            if (key === 't') triggerDemoResultNotification();
            if (key === 'escape') dismissResultPopup();
        });

        // 4. Smooth Points Counter Animator
        function animateCounter(elemId, startVal, endVal, duration = 800) {
            const elem = document.getElementById(elemId);
            if (!elem) return;
            if (startVal === endVal) {
                elem.innerText = endVal;
                return;
            }

            const startTime = performance.now();
            function step(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const current = Math.round(startVal + (endVal - startVal) * easeOut);
                elem.innerText = current;

                if (progress < 1) {
                    requestAnimationFrame(step);
                } else {
                    elem.innerText = endVal;
                }
            }
            requestAnimationFrame(step);
        }

        // 5. Update Standings & Team Cards
        // (Displays 3 stars for 1st place/leading team and 2 stars for 2nd team, removes 'Tied 1st' labels)
        function updateLeaderboardUI(houses) {
            if (!Array.isArray(houses) || houses.length === 0) return;

            let fanora = houses.find(h => (h.name && h.name.toLowerCase().includes('fanora')) || (h.captain && h.captain.toLowerCase().includes('afeef')));
            let zahora = houses.find(h => (h.name && h.name.toLowerCase().includes('zahora')) || (h.captain && h.captain.toLowerCase().includes('jabir')));

            const fPoints = fanora ? parseInt(fanora.points, 10) || 0 : 0;
            const zPoints = zahora ? parseInt(zahora.points, 10) || 0 : 0;

            // Animate Big Points Counters
            animateCounter('pts-count-fanora', previousFanoraPoints, fPoints);
            animateCounter('pts-count-zahora', previousZahoraPoints, zPoints);

            previousFanoraPoints = fPoints;
            previousZahoraPoints = zPoints;

            const rankFanoraElem = document.getElementById('rank-text-fanora');
            const rankZahoraElem = document.getElementById('rank-text-zahora');
            const badgeFanora = document.getElementById('badge-rank-fanora');
            const badgeZahora = document.getElementById('badge-rank-zahora');
            const badgeStarsFanora = document.getElementById('badge-stars-fanora');
            const badgeStarsZahora = document.getElementById('badge-stars-zahora');
            const footerStarsFanora = document.getElementById('stars-footer-fanora');
            const footerStarsZahora = document.getElementById('stars-footer-zahora');
            const fanoraPill = document.getElementById('fanora-margin-pill');
            const zahoraPill = document.getElementById('zahora-margin-pill');

            if (fPoints >= zPoints) {
                // Team Fanora is 1st / leading (3 stars), Team Zahora is 2nd (2 stars)
                const diff = fPoints - zPoints;
                if (rankFanoraElem) rankFanoraElem.innerText = '1ST PLACE';
                if (rankZahoraElem) rankZahoraElem.innerText = '2ND PLACE';

                if (badgeFanora) badgeFanora.className = 'px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl sm:rounded-2xl bg-amber-400 text-slate-950 font-black text-xs sm:text-sm lg:text-base tracking-widest uppercase font-mono shadow-2xl flex items-center gap-2 shrink-0';
                if (badgeZahora) badgeZahora.className = 'px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl sm:rounded-2xl bg-slate-800 text-emerald-400 border border-emerald-500/30 font-black text-xs sm:text-sm lg:text-base tracking-widest uppercase font-mono shadow-2xl flex items-center gap-2 shrink-0';

                // Display 3 stars for 1st place, 2 stars for 2nd team
                if (badgeStarsFanora) badgeStarsFanora.innerHTML = renderStarsHtml(3, 'text-slate-950', 'w-3.5 h-3.5 sm:w-4 sm:h-4');
                if (badgeStarsZahora) badgeStarsZahora.innerHTML = renderStarsHtml(2, 'text-emerald-400', 'w-3.5 h-3.5 sm:w-4 sm:h-4');

                if (footerStarsFanora) footerStarsFanora.innerHTML = renderStarsHtml(3, 'text-amber-300', 'w-5 h-5 sm:w-6 sm:h-6');
                if (footerStarsZahora) footerStarsZahora.innerHTML = renderStarsHtml(2, 'text-emerald-400', 'w-5 h-5 sm:w-6 sm:h-6');

                if (fanoraPill) {
                    fanoraPill.innerText = diff > 0 ? `Leading by +${diff} PTS` : 'Championship Leader';
                    fanoraPill.className = 'mt-2 sm:mt-3 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-amber-500/20 border border-amber-500/40 text-xs sm:text-sm font-mono font-bold text-amber-300';
                }
                if (zahoraPill) {
                    zahoraPill.innerText = diff > 0 ? `Trailing by -${diff} PTS` : 'Championship Contender';
                    zahoraPill.className = 'mt-2 sm:mt-3 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs sm:text-sm font-mono font-bold text-slate-400';
                }
            } else {
                // Team Zahora is 1st / leading (3 stars), Team Fanora is 2nd (2 stars)
                const diff = zPoints - fPoints;
                if (rankZahoraElem) rankZahoraElem.innerText = '1ST PLACE';
                if (rankFanoraElem) rankFanoraElem.innerText = '2ND PLACE';

                if (badgeZahora) badgeZahora.className = 'px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl sm:rounded-2xl bg-emerald-400 text-slate-950 font-black text-xs sm:text-sm lg:text-base tracking-widest uppercase font-mono shadow-2xl flex items-center gap-2 shrink-0';
                if (badgeFanora) badgeFanora.className = 'px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl sm:rounded-2xl bg-slate-800 text-amber-400 border border-amber-500/30 font-black text-xs sm:text-sm lg:text-base tracking-widest uppercase font-mono shadow-2xl flex items-center gap-2 shrink-0';

                // Display 3 stars for 1st place, 2 stars for 2nd team
                if (badgeStarsZahora) badgeStarsZahora.innerHTML = renderStarsHtml(3, 'text-slate-950', 'w-3.5 h-3.5 sm:w-4 sm:h-4');
                if (badgeStarsFanora) badgeStarsFanora.innerHTML = renderStarsHtml(2, 'text-amber-400', 'w-3.5 h-3.5 sm:w-4 sm:h-4');

                if (footerStarsZahora) footerStarsZahora.innerHTML = renderStarsHtml(3, 'text-emerald-300', 'w-5 h-5 sm:w-6 sm:h-6');
                if (footerStarsFanora) footerStarsFanora.innerHTML = renderStarsHtml(2, 'text-amber-400', 'w-5 h-5 sm:w-6 sm:h-6');

                if (zahoraPill) {
                    zahoraPill.innerText = `Leading by +${diff} PTS`;
                    zahoraPill.className = 'mt-2 sm:mt-3 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-xs sm:text-sm font-mono font-bold text-emerald-300';
                }
                if (fanoraPill) {
                    fanoraPill.innerText = `Trailing by -${diff} PTS`;
                    fanoraPill.className = 'mt-2 sm:mt-3 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs sm:text-sm font-mono font-bold text-slate-400';
                }
            }
        }

        // 6. Confetti Particle Animation
        function startConfettiExplosion() {
            const canvas = document.getElementById('confetti-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const colors = ['#f59e0b', '#fbbf24', '#10b981', '#06b6d4', '#ffffff', '#ec4899', '#8b5cf6'];

            for (let i = 0; i < 120; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * -canvas.height * 0.5,
                    size: Math.random() * 8 + 4,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    speedX: (Math.random() - 0.5) * 5,
                    speedY: Math.random() * 4 + 3,
                    rotation: Math.random() * 360,
                    rotationSpeed: (Math.random() - 0.5) * 8
                });
            }

            let animId;
            let duration = 3500;
            const start = performance.now();

            function render() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                const now = performance.now();

                particles.forEach(p => {
                    p.x += p.speedX;
                    p.y += p.speedY;
                    p.rotation += p.rotationSpeed;

                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate((p.rotation * Math.PI) / 180);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
                    ctx.restore();
                });

                if (now - start < duration) {
                    animId = requestAnimationFrame(render);
                } else {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    cancelAnimationFrame(animId);
                }
            }
            render();
        }

        // 7. Poster Viewport Responsive Auto-Scale Engine (1920x1080 Native TV Resolution)
        function updatePosterViewportScale() {
            const container = document.getElementById('poster-viewport-container');
            const card = document.getElementById('tv-poster-card');
            const topBar = document.getElementById('popup-top-bar');
            const bottomBar = document.getElementById('popup-bottom-bar');
            if (!container || !card) return;

            const baseWidth = 1920;
            const baseHeight = 1080;

            // Maximum allowed height to comfortably fit inside viewport with top bar and bottom bar
            const maxAvailableH = Math.min(window.innerHeight * 0.78, window.innerHeight - 150);
            const maxAvailableW = Math.min(window.innerWidth * 0.92, window.innerWidth - 48);

            let targetH = maxAvailableH;
            let targetW = targetH * (baseWidth / baseHeight);

            if (targetW > maxAvailableW) {
                targetW = maxAvailableW;
                targetH = targetW * (baseHeight / baseWidth);
            }

            const scale = targetW / baseWidth;

            container.style.height = `${targetH}px`;
            container.style.width = `${targetW}px`;
            card.style.transform = `scale(${scale})`;

            // Lock header bar and progress countdown bar to exact 16:9 poster card width
            if (topBar) {
                topBar.style.width = `${targetW}px`;
                topBar.style.maxWidth = `${targetW}px`;
            }
            if (bottomBar) {
                bottomBar.style.width = `${targetW}px`;
                bottomBar.style.maxWidth = `${targetW}px`;
            }
        }

        window.addEventListener('resize', () => {
            if (isPopupActive) {
                updatePosterViewportScale();
            }
        });

        // 8. Normalize & Extract Competition Winners Helper
        function normalizePosterWinners(compData) {
            let raw = [];
            if (Array.isArray(compData.winners) && compData.winners.length > 0) {
                raw = compData.winners;
            } else if (Array.isArray(compData.items) && compData.items.length > 0) {
                raw = compData.items;
            } else if (Array.isArray(compData.results) && compData.results.length > 0) {
                raw = compData.results;
            } else if (Array.isArray(compData.participants) && compData.participants.length > 0) {
                raw = compData.participants;
            }

            const list = raw.map((w, idx) => {
                let rank = 1;
                const rStr = String(w.rank !== undefined ? w.rank : (w.position !== undefined ? w.position : (w.prize || ''))).toLowerCase().trim();
                if (w.rank !== undefined && !isNaN(parseInt(w.rank, 10)) && parseInt(w.rank, 10) > 0) {
                    rank = parseInt(w.rank, 10);
                } else if (rStr.includes('1st') || rStr === '1' || rStr.includes('first')) {
                    rank = 1;
                } else if (rStr.includes('2nd') || rStr === '2' || rStr.includes('second')) {
                    rank = 2;
                } else if (rStr.includes('3rd') || rStr === '3' || rStr.includes('third')) {
                    rank = 3;
                } else {
                    const match = rStr.match(/\d+/);
                    rank = match ? parseInt(match[0], 10) : (idx + 1);
                }

                const name = (w.participant || w.participantName || w.name || w.candidateName || w.studentName || '').trim();
                const team = (w.team || w.teamName || w.rawTeamName || w.displayTeam || '').trim();

                return {
                    ...w,
                    rank: rank > 0 ? rank : (idx + 1),
                    participant: name || 'Participant',
                    team: team || '-'
                };
            });

            const valid = list.filter(w => w.participant && w.participant !== '-');
            valid.sort((a, b) => a.rank - b.rank);
            return valid;
        }

        function escapePosterHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatCompetitionTitle(title) {
            if (!title) return '';
            const trimmed = String(title).trim();
            const words = trimmed.split(/\s+/);
            if (words.length === 2 && trimmed.length <= 26) {
                return `${escapePosterHtml(words[0])}<br>${escapePosterHtml(words[1])}`;
            }
            if (words.length >= 3 && words.length <= 5 && trimmed.length <= 34) {
                const mid = Math.ceil(words.length / 2);
                return `${escapePosterHtml(words.slice(0, mid).join(' '))}<br>${escapePosterHtml(words.slice(mid).join(' '))}`;
            }
            return escapePosterHtml(trimmed);
        }

        function getRankBadgeHtml(rank, top, left = 332, diameter = 78) {
            let num = '1';
            let ord = 'st';
            if (rank === 2) { num = '2'; ord = 'nd'; }
            else if (rank === 3) { num = '3'; ord = 'rd'; }
            const fontSize = Math.round(diameter * 0.40);
            return `
            <div style="position: absolute; top: ${top}px; left: ${left}px; width: ${diameter}px; height: ${diameter}px; border-radius: 50%; border: 2.5px solid #ffffff; display: flex; align-items: center; justify-content: center; font-family: 'Nohemi-Medium', 'Nohemi', sans-serif; font-size: ${fontSize}px; font-weight: 500; color: #ffffff; z-index: 10;">
                <span style="display: flex; align-items: baseline; justify-content: center; transform: translateY(-1px);">
                    <span>${num}</span><span style="font-size: 0.58em; font-family: 'Nohemi-Regular', 'Nohemi', sans-serif; transform: translateY(-6px); margin-left: 1px;">${ord}</span>
                </span>
            </div>`;
        }

        // Helper: Zone Theme Classes for TV Poster & Status Bar
        function getZoneThemeClass(zone) {
            const z = String(zone || '').toUpperCase();
            if (z.includes('PRIME')) return 'zone-prime';
            if (z.includes('CORE')) return 'zone-core';
            if (z.includes('ALPHA')) return 'zone-alpha';
            return 'zone-default';
        }

        function getStatusBarZoneClass(zone) {
            const z = String(zone || '').toUpperCase();
            if (z.includes('PRIME')) return 'bg-amber-950/70 text-amber-300 border-amber-500/50';
            if (z.includes('CORE')) return 'bg-purple-950/70 text-purple-300 border-purple-500/50';
            if (z.includes('ALPHA')) return 'bg-slate-800 text-cyan-400 border-cyan-500/40';
            return 'bg-slate-800 text-slate-200 border-slate-600/30';
        }

        // 9. Dynamic Result Poster Popup Engine (10-15s duration with instant display)
        function showResultPopup(compData) {
            if (!compData) return;
            isPopupActive = true;

            const modal = document.getElementById('result-popup-modal');
            const categoryBadge = document.getElementById('popup-category-badge');
            const progressBar = document.getElementById('popup-progress-bar');
            const countdownLabel = document.getElementById('popup-countdown-label');
            const countdownBadge = document.getElementById('popup-countdown-badge');

            // 1. Format Result Number on top left with Nohemi Medium font
            let resNum = compData.formattedCode || compData.code || compData.resultNumber || compData.resultNo || compData.itemCode || '01';
            resNum = String(resNum).trim();
            if (/^\d+$/.test(resNum) && resNum.length < 2) {
                resNum = resNum.padStart(2, '0');
            }
            const resNumElem = document.getElementById('tv-poster-res-num');
            if (resNumElem) resNumElem.innerText = resNum;

            // 2. Zone Name Processing & Update (Dynamic Header directly above Competition Title)
            let rawZone = compData.zone || compData.zoneName || compData.zone_name || compData.category || compData.categoryName || compData.catName || compData.stageCategory || 'ALPHA ZONE';
            if (typeof rawZone === 'object' && rawZone !== null) {
                rawZone = rawZone.name || rawZone.title || rawZone.label || rawZone.zone || 'ALPHA ZONE';
            }
            let cleanZone = String(rawZone).trim().toUpperCase();
            if (cleanZone === 'PRIME' || cleanZone === 'PRIME ZONE') cleanZone = 'PRIME ZONE';
            else if (cleanZone === 'CORE' || cleanZone === 'CORE ZONE') cleanZone = 'CORE ZONE';
            else if (cleanZone === 'ALPHA' || cleanZone === 'ALPHA ZONE') cleanZone = 'ALPHA ZONE';
            else if (!cleanZone.includes('ZONE') && cleanZone.length > 0) cleanZone = `${cleanZone} ZONE`;
            else if (!cleanZone) cleanZone = 'ALPHA ZONE';

            // Update TV Poster Zone Badge directly above competition title
            const zoneTextElem = document.getElementById('tv-poster-zone');
            if (zoneTextElem) zoneTextElem.innerText = cleanZone;

            const zoneBadgeElem = document.getElementById('tv-poster-zone-badge');
            if (zoneBadgeElem) {
                zoneBadgeElem.className = 'tv-poster-zone-badge ' + getZoneThemeClass(cleanZone);
            }

            // Update Top Floating Status Bar Zone Badge
            if (categoryBadge) {
                categoryBadge.innerText = cleanZone;
                categoryBadge.className = 'px-3 py-1 rounded-xl text-[11px] sm:text-xs font-mono font-bold uppercase border ' + getStatusBarZoneClass(cleanZone);
            }

            // 3. Competition Name with Nohemi Light font
            const compTitle = compData.title || compData.name || compData.competitionName || 'Competition Item';
            const titleElem = document.getElementById('tv-poster-title');
            if (titleElem) {
                titleElem.innerHTML = formatCompetitionTitle(compTitle);
                const rawLen = compTitle.length;
                if (rawLen > 32) {
                    titleElem.style.fontSize = '44px';
                    titleElem.style.lineHeight = '1.12';
                } else if (rawLen > 20) {
                    titleElem.style.fontSize = '52px';
                    titleElem.style.lineHeight = '1.08';
                } else {
                    titleElem.style.fontSize = '62px';
                    titleElem.style.lineHeight = '1.05';
                }
            }

            // 3. Display ONLY 1st, 2nd, and 3rd place winner details (filter out rank > 3)
            const allWinners = normalizePosterWinners(compData);
            const winnersList = allWinners.filter(w => w.rank >= 1 && w.rank <= 3);
            const winnerCount = winnersList.length;

            const bgImg = document.getElementById('tv-poster-bg');
            const circleCover = document.getElementById('tv-poster-circle-cover');
            const winnersContainer = document.getElementById('tv-poster-winners-container');

            const rankSequence = winnersList.map(w => w.rank).join(',');

            // 4. Handle multiple winners for the same rank (e.g., two 3rd places or two 2nd places)
            if (winnerCount === 4 && rankSequence === '1,2,3,3') {
                // Exact Two 3rd Places reference: Tv-Result-Model-If-(2-Third).jpg with template
                if (bgImg) bgImg.src = '/images/Tv-Result-Model-If-(2-Third)-Tublate.jpg';
                if (circleCover) circleCover.style.display = 'none';

                const rowCoords = [
                    { top: 472, left: 488 },
                    { top: 578, left: 488 },
                    { top: 682, left: 488 },
                    { top: 793, left: 488 }
                ];

                let rowsHtml = '';
                winnersList.forEach((w, idx) => {
                    const coord = rowCoords[idx] || { top: 472 + (idx * 108), left: 488 };
                    rowsHtml += `
                    <div style="position: absolute; top: ${coord.top}px; left: ${coord.left}px; width: 880px; z-index: 10;">
                        <div style="font-family: 'Nohemi-Medium', 'Nohemi', sans-serif; font-size: 48px; font-weight: 500; color: #ffffff; line-height: 1.1; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            ${escapePosterHtml(w.participant)}
                        </div>
                        <div style="font-family: 'Nohemi-Regular', 'Nohemi', sans-serif; font-size: 24px; font-weight: 400; color: #ffffff; margin-top: 5px; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            ${escapePosterHtml(w.team)}
                        </div>
                    </div>`;
                });
                if (winnersContainer) winnersContainer.innerHTML = rowsHtml;

            } else if (winnerCount === 3 && rankSequence === '1,2,3') {
                // Exact Standard 3-Winner reference: Tv-Result-Model.jpg
                if (bgImg) bgImg.src = '/images/Tv-Result-Tumblate.jpg';
                if (circleCover) circleCover.style.display = 'none';

                const rowCoords = [
                    { top: 492, left: 507 },
                    { top: 622, left: 507 },
                    { top: 752, left: 507 }
                ];

                let rowsHtml = '';
                winnersList.forEach((w, idx) => {
                    const coord = rowCoords[idx] || { top: 492 + (idx * 130), left: 507 };
                    rowsHtml += `
                    <div style="position: absolute; top: ${coord.top}px; left: ${coord.left}px; width: 880px; z-index: 10;">
                        <div style="font-family: 'Nohemi-Medium', 'Nohemi', sans-serif; font-size: 54px; font-weight: 500; color: #ffffff; line-height: 1.1; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            ${escapePosterHtml(w.participant)}
                        </div>
                        <div style="font-family: 'Nohemi-Regular', 'Nohemi', sans-serif; font-size: 26px; font-weight: 400; color: #ffffff; margin-top: 6px; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            ${escapePosterHtml(w.team)}
                        </div>
                    </div>`;
                });
                if (winnersContainer) winnersContainer.innerHTML = rowsHtml;

            } else {
                // Multiple winners for same rank (e.g., two 2nd places [1, 2, 2, 3], two 1st places, or ties)
                // Duplicate the rank row downwards cleanly!
                if (bgImg) bgImg.src = '/images/Tv-Result-Tumblate.jpg';
                if (circleCover) circleCover.style.display = 'block';

                let rowsHtml = '';
                if (winnerCount === 4) {
                    // 4 rows (e.g. two 2nd places: 1st, 2nd, 2nd, 3rd)
                    const rowCoords = [
                        { textTop: 472, circleTop: 476 },
                        { textTop: 578, circleTop: 588 },
                        { textTop: 682, circleTop: 696 },
                        { textTop: 793, circleTop: 808 }
                    ];

                    winnersList.forEach((w, idx) => {
                        const coord = rowCoords[idx] || { textTop: 472 + (idx * 108), circleTop: 476 + (idx * 108) };
                        rowsHtml += getRankBadgeHtml(w.rank, coord.circleTop, 332, 74);
                        rowsHtml += `
                        <div style="position: absolute; top: ${coord.textTop}px; left: 488px; width: 880px; z-index: 10;">
                            <div style="font-family: 'Nohemi-Medium', 'Nohemi', sans-serif; font-size: 48px; font-weight: 500; color: #ffffff; line-height: 1.1; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                ${escapePosterHtml(w.participant)}
                            </div>
                            <div style="font-family: 'Nohemi-Regular', 'Nohemi', sans-serif; font-size: 24px; font-weight: 400; color: #ffffff; margin-top: 5px; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                ${escapePosterHtml(w.team)}
                            </div>
                        </div>`;
                    });
                } else if (winnerCount >= 5) {
                    // 5 or more winners (multiple ties): scale spacing gracefully downwards
                    const spacing = Math.floor(410 / winnerCount);
                    const nameSize = Math.max(34, Math.floor(210 / winnerCount));
                    const teamSize = Math.max(18, Math.floor(115 / winnerCount));
                    const badgeDia = Math.max(56, Math.floor(320 / winnerCount));

                    winnersList.forEach((w, idx) => {
                        const textTop = 460 + (idx * spacing);
                        const circleTop = 460 + (idx * spacing) + 4;
                        rowsHtml += getRankBadgeHtml(w.rank, circleTop, 336, badgeDia);
                        rowsHtml += `
                        <div style="position: absolute; top: ${textTop}px; left: 488px; width: 880px; z-index: 10;">
                            <div style="font-family: 'Nohemi-Medium', 'Nohemi', sans-serif; font-size: ${nameSize}px; font-weight: 500; color: #ffffff; line-height: 1.1; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                ${escapePosterHtml(w.participant)}
                            </div>
                            <div style="font-family: 'Nohemi-Regular', 'Nohemi', sans-serif; font-size: ${teamSize}px; font-weight: 400; color: #ffffff; margin-top: 4px; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                ${escapePosterHtml(w.team)}
                            </div>
                        </div>`;
                    });
                } else {
                    // 1, 2, or 3 winners with non-standard distribution
                    const rowCoords = [
                        { textTop: 492, circleTop: 496 },
                        { textTop: 622, circleTop: 628 },
                        { textTop: 752, circleTop: 758 }
                    ];

                    winnersList.forEach((w, idx) => {
                        const coord = rowCoords[idx] || { textTop: 492 + (idx * 130), circleTop: 496 + (idx * 130) };
                        rowsHtml += getRankBadgeHtml(w.rank, coord.circleTop, 332, 84);
                        rowsHtml += `
                        <div style="position: absolute; top: ${coord.textTop}px; left: 507px; width: 880px; z-index: 10;">
                            <div style="font-family: 'Nohemi-Medium', 'Nohemi', sans-serif; font-size: 54px; font-weight: 500; color: #ffffff; line-height: 1.1; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                ${escapePosterHtml(w.participant)}
                            </div>
                            <div style="font-family: 'Nohemi-Regular', 'Nohemi', sans-serif; font-size: 26px; font-weight: 400; color: #ffffff; margin-top: 6px; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                ${escapePosterHtml(w.team)}
                            </div>
                        </div>`;
                    });
                }
                if (winnersContainer) winnersContainer.innerHTML = rowsHtml;
            }

            // Adjust scaling to fit TV viewport
            updatePosterViewportScale();

            // Play Chime & Festive Particles
            playChimeSound();
            startConfettiExplosion();

            // Display Modal
            modal.classList.add('active');

            // 12-Second Countdown Progress Bar (10-15s duration requirement)
            const totalDurationMs = 12000;
            const startTime = Date.now();
            progressBar.style.width = '100%';

            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                const elapsed = Date.now() - startTime;
                const remaining = Math.max(0, totalDurationMs - elapsed);
                const percent = Math.max(0, (remaining / totalDurationMs) * 100);
                progressBar.style.width = `${percent}%`;
                const sec = Math.ceil(remaining / 1000);
                countdownLabel.innerText = `${sec}s remaining`;
                countdownBadge.innerText = `${sec}s`;

                if (remaining <= 0) {
                    clearInterval(countdownInterval);
                }
            }, 100);

            clearTimeout(popupTimer);
            popupTimer = setTimeout(() => {
                dismissResultPopup();
            }, totalDurationMs);
        }

        function dismissResultPopup() {
            const modal = document.getElementById('result-popup-modal');
            modal.classList.remove('active');
            clearInterval(countdownInterval);
            clearTimeout(popupTimer);
            isPopupActive = false;

            // Process next notification in queue if any
            setTimeout(() => {
                if (notificationQueue.length > 0) {
                    const nextComp = notificationQueue.shift();
                    showResultPopup(nextComp);
                }
            }, 600);
        }

        function enqueueNotification(comp) {
            if (isPopupActive) {
                notificationQueue.push(comp);
            } else {
                showResultPopup(comp);
            }
        }

        // 10. Manual Simulation / Demo Trigger (Press T)
        let demoCycleIndex = 0;
        function triggerDemoResultNotification() {
            demoCycleIndex = (demoCycleIndex + 1) % 4;

            let demoComp;
            if (demoCycleIndex === 1) {
                // Demo 1: Alpha Zone standard 3-winners layout (Poem Making)
                demoComp = {
                    id: 'demo_' + Date.now(),
                    formattedCode: '02',
                    code: '02',
                    resultNumber: '02',
                    name: 'Poem Making',
                    title: 'Poem Making',
                    zone: 'ALPHA ZONE',
                    zoneName: 'ALPHA ZONE',
                    category: 'ALPHA ZONE',
                    winners: [
                        { participant: 'Muhammed Swalih', name: 'Muhammed Swalih', rank: 1, team: 'Team Fanora' },
                        { participant: 'Muhammed Swalih', name: 'Muhammed Swalih', rank: 2, team: 'Team Fanora' },
                        { participant: 'Muhammed Swalih', name: 'Muhammed Swalih', rank: 3, team: 'Team Fanora' }
                    ]
                };
