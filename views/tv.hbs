<!DOCTYPE html>
<html class="dark overflow-hidden" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover" name="viewport" />
    <title>{{title}}</title>

    <!-- PWA & Theme Color -->
    <link rel="manifest" href="/manifest-tv.json" />
    <meta name="theme-color" content="#030610" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Euphoria TV" />
    <meta name="application-name" content="Euphoria TV" />

    <!-- Favicon Links -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo-32.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/logo-192.png">
    <link rel="shortcut icon" href="/images/favicon.ico">

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            gold: '#f59e0b',
                            goldLight: '#fbbf24',
                            amberDark: '#b45309',
                            emerald: '#10b981',
                            emeraldDark: '#047857',
                            cyan: '#06b6d4',
                            deepDark: '#030610',
                            cardDark: '#0a0f24',
                            panelDark: '#070c1d'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Outfit', 'sans-serif'],
                        heading: ['Outfit', 'Chakra Petch', 'sans-serif'],
                        mono: ['Chakra Petch', 'ui-monospace', 'monospace']
                    }
                }
            }
        };
    </script>

    <!-- Custom TV Styling, Typography & Poster Fonts -->
    <style>
        /* TV Layout Scaling & 100% Screen Stretch */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        html {
            width: 100% !important;
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            box-sizing: border-box !important;
        }

        body {
            width: 100vw !important;
            max-width: 100vw !important;
            height: 100vh !important;
            max-height: 100vh !important;
            margin: 0 !important;
            padding: clamp(14px, 1.8vw, 24px) clamp(18px, 2.4vw, 36px) !important;
            overflow: hidden !important;
            box-sizing: border-box !important;
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
        }
        /* Exact High-Resolution Poster Fonts */
        @font-face {
            font-family: 'Nohemi-Light';
            src: url('/Font/Poster%20Font/Nohemi-Light-BF6438cc583f70b.otf') format('opentype'),
                url('/Font/Poster Font/Nohemi-Light-BF6438cc583f70b.otf') format('opentype');
            font-weight: 300;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Nohemi-Regular';
            src: url('/Font/Poster%20Font/Nohemi-Regular-BF6438cc58b98fc.otf') format('opentype'),
                url('/Font/Poster Font/Nohemi-Regular-BF6438cc58b98fc.otf') format('opentype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Nohemi-Medium';
            src: url('/Font/Poster%20Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype'),
                url('/Font/Poster Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype');
            font-weight: 500;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Nohemi-SemiBold';
            src: url('/Font/Poster%20Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype'),
                url('/Font/Poster Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype');
            font-weight: 600;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Nohemi';
            src: url('/Font/Poster%20Font/Nohemi-Light-BF6438cc583f70b.otf') format('opentype'),
                url('/Font/Poster Font/Nohemi-Light-BF6438cc583f70b.otf') format('opentype');
            font-weight: 300;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Nohemi';
            src: url('/Font/Poster%20Font/Nohemi-Regular-BF6438cc58b98fc.otf') format('opentype'),
                url('/Font/Poster Font/Nohemi-Regular-BF6438cc58b98fc.otf') format('opentype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Nohemi';
            src: url('/Font/Poster%20Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype'),
                url('/Font/Poster Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype');
            font-weight: 500;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Nohemi';
            src: url('/Font/Poster%20Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype'),
                url('/Font/Poster Font/Nohemi-SemiBold-BF6438cc588a48a.ttf') format('truetype');
            font-weight: 600;
            font-style: normal;
            font-display: swap;
        }

        /* Ambient Glow & High-Contrast Scorecards */
        .tv-fanora-card {
            background: radial-gradient(circle at 10% 10%, rgba(245, 158, 11, 0.28) 0%, rgba(15, 23, 42, 0.92) 55%),
                        linear-gradient(180deg, rgba(15, 23, 42, 0.95) 0%, rgba(4, 7, 18, 0.98) 100%);
            border: 2px solid rgba(245, 158, 11, 0.45);
            box-shadow: 0 0 80px rgba(245, 158, 11, 0.18), inset 0 1px 0 rgba(251, 191, 36, 0.35);
        }

        .tv-zahora-card {
            background: radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.28) 0%, rgba(15, 23, 42, 0.92) 55%),
                        linear-gradient(180deg, rgba(15, 23, 42, 0.95) 0%, rgba(4, 7, 18, 0.98) 100%);
            border: 2px solid rgba(16, 185, 129, 0.45);
            box-shadow: 0 0 80px rgba(16, 185, 129, 0.18), inset 0 1px 0 rgba(52, 211, 153, 0.35);
        }

        .gold-shimmer {
            background: linear-gradient(90deg, #fef08a 0%, #f59e0b 35%, #ffffff 50%, #f59e0b 65%, #d97706 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textShimmer 4s linear infinite;
        }

        @keyframes textShimmer {
            to { background-position: 200% center; }
        }

        /* Animated Full-Screen Result Poster Popup Overlay */
        #result-popup-modal {
            transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
        }

        #result-popup-modal.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        #poster-viewport-container {
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform: scale(0.88) translateY(30px);
        }

        #result-popup-modal.active #poster-viewport-container {
            transform: scale(1) translateY(0);
        }

        /* Ambient animated backgrounds */
        .ambient-glow-amber {
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.18) 0%, rgba(0, 0, 0, 0) 70%);
            top: -200px;
            left: -200px;
            filter: blur(100px);
            pointer-events: none;
            z-index: 0;
        }

        .ambient-glow-emerald {
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.18) 0%, rgba(0, 0, 0, 0) 70%);
            bottom: -200px;
            right: -200px;
            filter: blur(100px);
            pointer-events: none;
            z-index: 0;
        }

        /* ======================================================== */
        /* TV Live Display: Competition Header & Zone Name Styling   */
        /* ======================================================== */
        .tv-poster-zone-badge {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            padding: 8px 24px;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.08);
            border: 1.5px solid rgba(255, 255, 255, 0.22);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            margin-bottom: 14px;
            transition: all 0.4s ease;
        }

        .tv-poster-zone-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
            display: inline-block;
            transition: all 0.4s ease;
        }

        .tv-poster-zone-text {
            font-family: 'Nohemi-Medium', 'Nohemi-Regular', 'Nohemi', sans-serif;
            font-size: 28px;
            font-weight: 500;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            line-height: 1;
            margin: 0;
            padding: 0;
            white-space: nowrap;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
            transition: color 0.3s ease;
        }

        /* Prime Zone Theme (Warm Festival Gold / Amber) */
        .tv-poster-zone-badge.zone-prime {
            background: rgba(245, 158, 11, 0.14);
            border-color: rgba(245, 158, 11, 0.55);
            box-shadow: 0 4px 28px rgba(245, 158, 11, 0.28), inset 0 1px 0 rgba(251, 191, 36, 0.35);
        }
        .tv-poster-zone-badge.zone-prime .tv-poster-zone-dot {
            background: #f59e0b;
            box-shadow: 0 0 14px #f59e0b, 0 0 28px rgba(245, 158, 11, 0.7);
        }
        .tv-poster-zone-badge.zone-prime .tv-poster-zone-text {
            color: #fbbf24;
        }

        /* Alpha Zone Theme (Cyan / Electric Blue) */
        .tv-poster-zone-badge.zone-alpha {
            background: rgba(6, 182, 212, 0.14);
            border-color: rgba(6, 182, 212, 0.55);
            box-shadow: 0 4px 28px rgba(6, 182, 212, 0.28), inset 0 1px 0 rgba(103, 232, 249, 0.35);
        }
        .tv-poster-zone-badge.zone-alpha .tv-poster-zone-dot {
            background: #06b6d4;
            box-shadow: 0 0 14px #06b6d4, 0 0 28px rgba(6, 182, 212, 0.7);
        }
        .tv-poster-zone-badge.zone-alpha .tv-poster-zone-text {
            color: #38bdf8;
        }

        /* Core Zone Theme (Amethyst / Regal Purple) */
        .tv-poster-zone-badge.zone-core {
            background: rgba(168, 85, 247, 0.14);
            border-color: rgba(168, 85, 247, 0.55);
            box-shadow: 0 4px 28px rgba(168, 85, 247, 0.28), inset 0 1px 0 rgba(216, 180, 254, 0.35);
        }
        .tv-poster-zone-badge.zone-core .tv-poster-zone-dot {
            background: #a855f7;
            box-shadow: 0 0 14px #a855f7, 0 0 28px rgba(168, 85, 247, 0.7);
        }
        .tv-poster-zone-badge.zone-core .tv-poster-zone-text {
            color: #c084fc;
        }

        /* Neutral / Default Zone Theme */
        .tv-poster-zone-badge.zone-default {
            background: rgba(255, 255, 255, 0.10);
            border-color: rgba(255, 255, 255, 0.30);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
        }
        .tv-poster-zone-badge.zone-default .tv-poster-zone-dot {
            background: #ffffff;
            box-shadow: 0 0 14px #ffffff;
        }
        .tv-poster-zone-badge.zone-default .tv-poster-zone-text {
            color: #f8fafc;
        }
    </style>
</head>

<body class="bg-[#030610] text-slate-100 font-sans h-screen w-full min-w-full max-w-full overflow-hidden select-none p-4 sm:p-6 lg:p-8 relative flex flex-col justify-between">

    <!-- Ambient Background Atmospheric Lights -->
    <div class="ambient-glow-amber"></div>
    <div class="ambient-glow-emerald"></div>

    <!-- Canvas for Confetti & Celebration Particles in Result Popup -->
    <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

    <!-- ============================================== -->
    <!-- 1. TOP CORNER: SUBTLE SCREEN CONTROLS          -->
    <!-- (Clock/Time completely removed as requested)    -->
    <!-- ============================================== -->
    <div class="absolute top-5 right-5 sm:top-6 sm:right-8 lg:top-8 lg:right-10 z-30 flex items-center gap-3">
        
        <!-- Audio Chime Toggle Button (Press M) -->
        <button id="audio-toggle-btn" onclick="toggleAudioChime()" title="Toggle Sound Chime (Press M)"
            class="p-2.5 rounded-2xl bg-slate-950/80 backdrop-blur-2xl hover:bg-slate-800/80 text-slate-300 hover:text-white border border-slate-800/80 transition-all active:scale-95 shadow-xl">
            <span id="audio-icon" class="material-symbols-outlined text-lg text-emerald-400">volume_up</span>
        </button>

        <!-- Fullscreen Controller (Press F) -->
        <button id="fullscreen-toggle-btn" onclick="toggleFullscreen()" title="Toggle Fullscreen (Press F)"
            class="p-2.5 rounded-2xl bg-slate-950/80 backdrop-blur-2xl hover:bg-slate-800/80 text-slate-300 hover:text-white border border-slate-800/80 transition-all active:scale-95 shadow-xl">
            <span id="fullscreen-icon" class="material-symbols-outlined text-lg">fullscreen</span>
        </button>

        <!-- Dynamic Poster Popup Test Alert (Press T) -->
        <button onclick="triggerDemoResultNotification()" title="Simulate Dynamic Result Poster Popup (Press T)"
            class="px-3.5 py-2.5 rounded-2xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-mono font-bold transition-all flex items-center gap-1.5 active:scale-95 shadow-xl">
            <span class="material-symbols-outlined text-sm">campaign</span>
            <span class="hidden sm:inline">Test Poster Alert</span>
        </button>

    </div>

    <!-- ============================================== -->
    <!-- 2. TWO MAIN TEAM SCORECARDS (SIDE-BY-SIDE FLEX) -->
    <!-- ============================================== -->
    <main class="w-full h-full flex-1 flex flex-row items-stretch justify-center gap-4 sm:gap-5 lg:gap-6 relative z-10 min-h-0 min-w-0">

        <!-- ========================================== -->
        <!-- A. TEAM FANORA SCORECARD (LEFT)            -->
        <!-- ========================================== -->
        <div id="card-team-fanora" class="tv-fanora-card flex-1 w-1/2 min-w-0 rounded-[1.75rem] sm:rounded-[2.25rem] lg:rounded-[2.5rem] p-5 sm:p-6 lg:p-8 flex flex-col justify-between relative overflow-hidden transition-all duration-700 h-full">
            
            <!-- Giant Watermark Background Letter -->
            <div class="absolute -right-6 -bottom-6 text-amber-500/[0.04] select-none pointer-events-none font-black text-[10rem] sm:text-[14rem] lg:text-[18rem] font-heading leading-none">
                F
            </div>

            <!-- Top Header: Crest, Team Name & Dynamic Rank Badge with Stars -->
            <div class="flex items-start justify-between relative z-10 shrink-0">
                <div class="flex items-center gap-3 sm:gap-4 lg:gap-5 min-w-0">
                    <div class="w-13 h-13 sm:w-16 sm:h-16 lg:w-18 lg:h-18 rounded-2xl sm:rounded-3xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-extrabold text-2xl sm:text-3xl lg:text-4xl shadow-2xl border border-amber-500/50 shrink-0">
                        <span class="material-symbols-outlined text-2xl sm:text-3xl lg:text-4xl">local_fire_department</span>
                    </div>
                    <div class="min-w-0">
                        <span class="text-[11px] sm:text-xs lg:text-sm font-mono uppercase tracking-widest text-amber-400 font-bold block truncate">
                            Championship House
                        </span>
                        <h2 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-heading font-black text-white tracking-wide uppercase drop-shadow-md truncate">
                            Team Fanora
                        </h2>
                    </div>
                </div>

                <!-- Rank Status Badge with Stars (3 stars for 1st place, 2 stars for 2nd) -->
                <div id="badge-rank-fanora" class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl sm:rounded-2xl bg-amber-400 text-slate-950 font-black text-xs sm:text-sm lg:text-base tracking-widest uppercase font-mono shadow-2xl flex items-center gap-2 shrink-0">
                    <div id="badge-stars-fanora" class="flex items-center gap-1">
                        <!-- Populated dynamically via JS -->
                    </div>
                    <span id="rank-text-fanora">1ST PLACE</span>
                </div>
            </div>

            <!-- Centerpiece: Points Counter -->
            <div class="my-auto py-2 sm:py-3 lg:py-4 text-center relative z-10 flex flex-col items-center justify-center flex-1 min-h-0">
                <p class="text-[11px] sm:text-xs lg:text-sm uppercase font-mono font-bold tracking-widest text-amber-400/90 mb-1 sm:mb-2">
                    Total Championship Score
                </p>
                <div class="text-6xl sm:text-7xl md:text-8xl lg:text-[7.5rem] xl:text-[9rem] font-mono font-black text-amber-400 tracking-tight drop-shadow-[0_20px_45px_rgba(245,158,11,0.35)] leading-none flex items-baseline justify-center gap-2 sm:gap-3">
                    <span id="pts-count-fanora">0</span>
                    <span class="text-xl sm:text-2xl lg:text-4xl font-extrabold text-amber-300 font-sans tracking-normal">PTS</span>
                </div>
                <div id="fanora-margin-pill" class="mt-2 sm:mt-3 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-amber-500/20 border border-amber-500/40 text-xs sm:text-sm font-mono font-bold text-amber-300">
                    Current Leader
                </div>
            </div>

            <!-- Bottom Footer: Team Name & Star Rating Display -->
            <div class="relative z-10 pt-3 sm:pt-4 border-t border-amber-500/20 flex items-center justify-between shrink-0">
                <div>
                    <span class="text-[10px] sm:text-xs font-mono uppercase text-amber-400/80 tracking-wider block font-bold">Team</span>
                    <span class="text-base sm:text-lg lg:text-2xl font-extrabold text-white tracking-wide">Team Fanora</span>
                </div>
                <div class="text-right flex flex-col items-end">
                    <span class="text-[10px] sm:text-xs font-mono uppercase text-amber-400/80 tracking-wider block font-bold mb-0.5 sm:mb-1">Championship Stars</span>
                    <div id="stars-footer-fanora" class="flex items-center gap-1 sm:gap-1.5 text-amber-300">
                        <!-- Populated dynamically via JS -->
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================================== -->
        <!-- B. TEAM ZAHORA SCORECARD (RIGHT)           -->
        <!-- ========================================== -->
        <div id="card-team-zahora" class="tv-zahora-card flex-1 w-1/2 min-w-0 rounded-[1.75rem] sm:rounded-[2.25rem] lg:rounded-[2.5rem] p-5 sm:p-6 lg:p-8 flex flex-col justify-between relative overflow-hidden transition-all duration-700 h-full">
            
            <!-- Giant Watermark Background Letter -->
            <div class="absolute -right-6 -bottom-6 text-emerald-500/[0.04] select-none pointer-events-none font-black text-[10rem] sm:text-[14rem] lg:text-[18rem] font-heading leading-none">
                Z
            </div>

            <!-- Top Header: Crest, Team Name & Dynamic Rank Badge with Stars -->
            <div class="flex items-start justify-between relative z-10 shrink-0">
                <div class="flex items-center gap-3 sm:gap-4 lg:gap-5 min-w-0">
                    <div class="w-13 h-13 sm:w-16 sm:h-16 lg:w-18 lg:h-18 rounded-2xl sm:rounded-3xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-extrabold text-2xl sm:text-3xl lg:text-4xl shadow-2xl border border-emerald-500/50 shrink-0">
                        <span class="material-symbols-outlined text-2xl sm:text-3xl lg:text-4xl">military_tech</span>
                    </div>
                    <div class="min-w-0">
                        <span class="text-[11px] sm:text-xs lg:text-sm font-mono uppercase tracking-widest text-emerald-400 font-bold block truncate">
                            Championship House
                        </span>
                        <h2 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-heading font-black text-white tracking-wide uppercase drop-shadow-md truncate">
                            Team Zahora
                        </h2>
                    </div>
                </div>

                <!-- Rank Status Badge with Stars (3 stars for 1st place, 2 stars for 2nd) -->
                <div id="badge-rank-zahora" class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl sm:rounded-2xl bg-slate-800 text-emerald-400 border border-emerald-500/30 font-black text-xs sm:text-sm lg:text-base tracking-widest uppercase font-mono shadow-2xl flex items-center gap-2 shrink-0">
                    <div id="badge-stars-zahora" class="flex items-center gap-1">
                        <!-- Populated dynamically via JS -->
                    </div>
                    <span id="rank-text-zahora">2ND PLACE</span>
                </div>
            </div>

            <!-- Centerpiece: Points Counter -->
            <div class="my-auto py-2 sm:py-3 lg:py-4 text-center relative z-10 flex flex-col items-center justify-center flex-1 min-h-0">
                <p class="text-[11px] sm:text-xs lg:text-sm uppercase font-mono font-bold tracking-widest text-emerald-400/90 mb-1 sm:mb-2">
                    Total Championship Score
                </p>
                <div class="text-6xl sm:text-7xl md:text-8xl lg:text-[7.5rem] xl:text-[9rem] font-mono font-black text-emerald-400 tracking-tight drop-shadow-[0_20px_45px_rgba(16,185,129,0.35)] leading-none flex items-baseline justify-center gap-2 sm:gap-3">
                    <span id="pts-count-zahora">0</span>
                    <span class="text-xl sm:text-2xl lg:text-4xl font-extrabold text-emerald-300 font-sans tracking-normal">PTS</span>
                </div>
                <div id="zahora-margin-pill" class="mt-2 sm:mt-3 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-xs sm:text-sm font-mono font-bold text-emerald-300">
                    Contender
                </div>
            </div>

            <!-- Bottom Footer: Team Name & Star Rating Display -->
            <div class="relative z-10 pt-3 sm:pt-4 border-t border-emerald-500/20 flex items-center justify-between shrink-0">
                <div>
                    <span class="text-[10px] sm:text-xs font-mono uppercase text-emerald-400/80 tracking-wider block font-bold">Team</span>
                    <span class="text-base sm:text-lg lg:text-2xl font-extrabold text-white tracking-wide">Team Zahora</span>
