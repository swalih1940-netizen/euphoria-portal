    <!-- Countdown Script -->
    <script>
        // Countdown Timer Script (Dynamic Admin Configured)
        const rawTargetDate = '{{festivalSetting.eventDateIso}}' || document.getElementById('countdown')?.dataset?.targetDate;
        const targetDate = new Date(rawTargetDate).getTime();

        function handleCountdownExpiry() {
            const cdSection = document.getElementById('countdown');
            if (cdSection) {
                cdSection.style.display = 'none';
                cdSection.classList.add('hidden');
            }
            const navWidget = document.getElementById('nav-countdown-widget');
            if (navWidget) {
                navWidget.style.display = 'none';
                navWidget.classList.add('hidden');
            }
        }

        if (targetDate && !isNaN(targetDate)) {
            function updateCD() {
                const now = new Date().getTime();
                const diff = targetDate - now;
                if (diff <= 0) {
                    handleCountdownExpiry();
                    return;
                }
                const days = String(Math.floor(diff / (1000 * 60 * 60 * 24))).padStart(2, '0');
                const hours = String(Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
                const mins = String(Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
                const secs = String(Math.floor((diff % (1000 * 60)) / 1000)).padStart(2, '0');

                // Main section countdown elements
                const elDays = document.getElementById('cd-days');
                if (elDays) elDays.innerText = days;
                const elHours = document.getElementById('cd-hours');
                if (elHours) elHours.innerText = hours;
                const elMins = document.getElementById('cd-mins');
                if (elMins) elMins.innerText = mins;
                const elSecs = document.getElementById('cd-secs');
                if (elSecs) elSecs.innerText = secs;

                // Header countdown widget elements
                const navDays = document.getElementById('nav-cd-days');
                if (navDays) navDays.innerText = days;
                const navHours = document.getElementById('nav-cd-hours');
                if (navHours) navHours.innerText = hours;
                const navMins = document.getElementById('nav-cd-mins');
                if (navMins) navMins.innerText = mins;
                const navSecs = document.getElementById('nav-cd-secs');
                if (navSecs) navSecs.innerText = secs;
            }

            updateCD();
            const cdInterval = setInterval(function () {
                const now = new Date().getTime();
                if (targetDate - now <= 0) {
                    clearInterval(cdInterval);
                    handleCountdownExpiry();
                } else {
                    updateCD();
                }
            }, 1000);
        } else {
            handleCountdownExpiry();
        }

        function shareCompetitionResult(id, title) {
            const shareUrl = window.location.origin + '/result#content-' + id;
            const shareTitle = title ? title + ' - Event Euphoria Results' : 'Event Euphoria Competition Results';

            if (navigator.share) {
                navigator.share({
                    title: shareTitle,
                    text: `Official Results for ${title || 'Event Euphoria'}:`,
                    url: shareUrl
                }).catch(() => { });
            } else if (navigator.clipboard) {
                navigator.clipboard.writeText(shareUrl).then(() => {
                    alert('Result link copied to clipboard!');
                }).catch(() => {
                    prompt('Copy result link:', shareUrl);
                });
            } else {
                prompt('Copy result link:', shareUrl);
            }
        }

        // Helper to convert any image Blob (including WebP/AVIF) to standard JPEG Blob
        function convertBlobToJpeg(blob, quality = 0.95) {
            return new Promise((resolve) => {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                const tempUrl = URL.createObjectURL(blob);
                img.onload = function () {
                    try {
                        const canvas = document.createElement('canvas');
                        canvas.width = img.naturalWidth || img.width;
                        canvas.height = img.naturalHeight || img.height;
                        const ctx = canvas.getContext('2d');
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(0, 0, canvas.width, canvas.height);
                        ctx.drawImage(img, 0, 0);
                        URL.revokeObjectURL(tempUrl);
                        canvas.toBlob((jpegBlob) => {
                            resolve(jpegBlob || blob);
                        }, 'image/jpeg', quality);
                    } catch (e) {
                        URL.revokeObjectURL(tempUrl);
                        resolve(blob);
                    }
                };
                img.onerror = function () {
                    URL.revokeObjectURL(tempUrl);
                    resolve(blob);
                };
                img.src = tempUrl;
            });
        }

        // Transforms Cloudinary URLs: strips .webp, replaces f_auto/f_webp with f_jpg, adds fl_attachment
        function formatCloudinaryUrlForDownload(url, filename = 'Euphoria Photo') {
            if (!url || !url.includes('cloudinary.com')) return url;
            let target = url;

            // 1. Remove .webp extension if present and force .jpg
            target = target.replace(/\.webp(\?.*)?$/i, '.jpg$1');

            // 2. Replace f_auto or f_webp with f_jpg in transformations
            target = target.replace(/([/,])f_(?:auto|webp)([,/])/g, '$1f_jpg$2');

            // 3. Inject fl_attachment with desired filename and f_jpg
            const safeName = encodeURIComponent(filename.replace(/\s+/g, '_'));
            if (target.includes('/image/upload/')) {
                if (!target.includes('fl_attachment')) {
                    target = target.replace('/image/upload/', `/image/upload/fl_attachment:${safeName},f_jpg/`);
                } else {
                    target = target.replace(/fl_attachment:[^,/]+/, `fl_attachment:${safeName}`);
                }
            }
            return target;
        }

        // High-Reliability Photo Downloader
        // 1. Prevents .webp format from Cloudinary or local files (converts to standard JPG or original PNG)
        // 2. Always names the downloaded file 'Euphoria Photo.jpg' (or 'Euphoria Photo.png')
        async function downloadPhoto(url, customName) {
            if (!url) return;

            const baseName = (customName && customName.trim()) ? customName.replace(/\.[^/.]+$/, '').trim() : 'Euphoria Photo';
            const targetUrl = formatCloudinaryUrlForDownload(url, baseName);
            const cleanUrl = targetUrl.split('?')[0].toLowerCase();

            try {
                const response = await fetch(targetUrl, { mode: 'cors' });
                if (!response.ok) throw new Error('Fetch status ' + response.status);
                let blob = await response.blob();

                let ext = '.jpg';
                // If WebP, AVIF, or unknown, convert to standard JPEG
                if (blob.type === 'image/webp' || blob.type === 'image/avif' || cleanUrl.endsWith('.webp')) {
                    blob = await convertBlobToJpeg(blob, 0.95);
                    ext = '.jpg';
                } else if (blob.type === 'image/png' || cleanUrl.endsWith('.png')) {
                    ext = '.png';
                } else {
                    ext = '.jpg';
                }

                const finalFilename = `${baseName}${ext}`;
                const blobUrl = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = blobUrl;
                link.download = finalFilename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);
            } catch (err) {
                console.warn('[downloadPhoto] Blob fetch failed, falling back to direct link:', err);
                const isPng = cleanUrl.endsWith('.png');
                const finalFilename = `${baseName}${isPng ? '.png' : '.jpg'}`;
                const link = document.createElement('a');
                link.href = targetUrl;
                link.download = finalFilename;
                link.target = '_blank';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        }

        // Direct Raw Photo Sharer
        async function sharePhoto(url) {
            if (!url) return;
            const fullUrl = url.startsWith('http') ? url : window.location.origin + url;
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: "Event Euphoria '26 Festival Photo",
                        text: "Event Euphoria '26 Festival Photo:",
                        url: fullUrl
                    });
                    return;
                } catch (e) {
                    if (e.name === 'AbortError') return;
                }
            }
            const whatsappText = `📸 *Event Euphoria '26 Festival Photo*\n\n${fullUrl}`;
            const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(whatsappText)}`;
            window.open(whatsappUrl, '_blank');
        }

        // Home Festival Gallery Clean Lightbox Logic
        (function() {
            let currentHomeIndex = 0;
            let homeCards = [];
            let currentHomePhotoSrc = '';

            const homeModal = document.getElementById('home-lightbox-modal');
            const homeLbImg = document.getElementById('home-lb-img');
            const homeLbCounter = document.getElementById('home-lb-counter');
            const homeFullscreenBtn = document.getElementById('home-lb-fullscreen-btn');
            const homeFullscreenIcon = document.getElementById('home-lb-fullscreen-icon');
            const homeFullscreenText = document.getElementById('home-lb-fullscreen-text');
            const homeDownloadBtn = document.getElementById('home-lb-download-btn');
            const homeShareBtn = document.getElementById('home-lb-share-btn');
            const homeCloseBtn = document.getElementById('home-lb-close-btn');
            const homePrevBtn = document.getElementById('home-lb-prev-btn');
            const homeNextBtn = document.getElementById('home-lb-next-btn');

            if (!homeModal) return;

            function updateHomeCards() {
                homeCards = Array.from(document.querySelectorAll('.home-gallery-card'));
            }

            function isHomeFullscreen() {
                return !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
            }

            function updateHomeFullscreenBtn() {
                if (!homeFullscreenIcon || !homeFullscreenText) return;
                if (isHomeFullscreen()) {
                    homeFullscreenIcon.textContent = 'fullscreen_exit';
                    homeFullscreenText.textContent = 'EXIT FULL SCREEN';
                } else {
                    homeFullscreenIcon.textContent = 'fullscreen';
                    homeFullscreenText.textContent = 'FULL SCREEN';
                }
            }

            function toggleHomeFullscreen() {
                if (!isHomeFullscreen()) {
                    const elem = homeModal || document.documentElement;
                    if (elem.requestFullscreen) elem.requestFullscreen().catch(() => {});
                    else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
                    else if (elem.mozRequestFullScreen) elem.mozRequestFullScreen();
                    else if (elem.msRequestFullscreen) elem.msRequestFullscreen();
                } else {
                    if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
                    else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                    else if (document.mozCancelFullScreen) document.mozCancelFullScreen();
                    else if (document.msExitFullscreen) document.msExitFullscreen();
                }
            }

            function openHomeLightbox(index) {
                updateHomeCards();
                if (homeCards.length === 0) return;
                if (index < 0) index = homeCards.length - 1;
                if (index >= homeCards.length) index = 0;

                currentHomeIndex = index;
                const card = homeCards[index];
                currentHomePhotoSrc = card.dataset.src;

                homeLbImg.src = currentHomePhotoSrc;
                homeLbCounter.innerText = `${currentHomeIndex + 1} / ${homeCards.length}`;

                homeModal.classList.add('active');
                document.body.style.overflow = 'hidden';

                const bottomNav = document.getElementById('floating-bottom-nav');
                if (bottomNav) {
                    bottomNav.style.display = 'none';
                }

                updateHomeFullscreenBtn();
            }

            function closeHomeLightbox() {
                homeModal.classList.remove('active');
                document.body.style.overflow = '';
                homeLbImg.src = '';

                if (isHomeFullscreen()) {
                    if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
                    else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                }

                const bottomNav = document.getElementById('floating-bottom-nav');
                if (bottomNav) {
                    bottomNav.style.display = '';
                }
            }

            function showNextHomePhoto() {
                openHomeLightbox(currentHomeIndex + 1);
            }

            function showPrevHomePhoto() {
                openHomeLightbox(currentHomeIndex - 1);
            }

            function bindHomeCardListeners() {
                updateHomeCards();
                homeCards.forEach((card, idx) => {
                    card.addEventListener('click', function() {
                        openHomeLightbox(idx);
                    });
                });
            }

            bindHomeCardListeners();

            async function fetchHomeLivePhotos() {
                try {
                    const res = await fetch('/api/gallery?_nocache=' + Date.now(), { cache: 'no-store' });
                    if (res.ok) {
                        const data = await res.json();
                        if (data && data.success && Array.isArray(data.photos)) {
                            const grid = document.getElementById('home-gallery-grid');
                            if (!grid) return;
                            const topPhotos = data.photos.slice(0, 8);
                            if (topPhotos.length === 0) {
                                grid.innerHTML = `
                                    <div class="col-span-full text-center py-12 text-slate-500">
                                        <p class="text-xs font-semibold">Photos will be published throughout festival days.</p>
                                    </div>`;
                            } else {
                                grid.innerHTML = topPhotos.map(p => `
                                    <div class="home-gallery-card group relative rounded-none overflow-hidden bg-slate-900/80 border border-slate-800 hover:border-amber-500/50 transition-all duration-300 shadow-lg sm:shadow-xl cursor-pointer"
                                        data-src="${p.imageUrl}">
                                        <div class="aspect-[4/3] w-full overflow-hidden bg-slate-950 relative">
                                            <img src="${p.imageUrl}" alt="${p.title || 'Festival Photo'}" loading="lazy"
                                                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                                        </div>
                                    </div>
                                `).join('');
                            }
                            bindHomeCardListeners();
                        }
                    }
                } catch (e) {}
            }

            fetchHomeLivePhotos();
            window.addEventListener('focus', fetchHomeLivePhotos);

            if (homeCloseBtn) homeCloseBtn.addEventListener('click', closeHomeLightbox);
            if (homeNextBtn) homeNextBtn.addEventListener('click', showNextHomePhoto);
            if (homePrevBtn) homePrevBtn.addEventListener('click', showPrevHomePhoto);

            if (homeFullscreenBtn) homeFullscreenBtn.addEventListener('click', toggleHomeFullscreen);
            if (homeDownloadBtn) {
                homeDownloadBtn.addEventListener('click', function() {
                    if (currentHomePhotoSrc) downloadPhoto(currentHomePhotoSrc);
                });
            }
            if (homeShareBtn) {
                homeShareBtn.addEventListener('click', function() {
                    if (currentHomePhotoSrc) sharePhoto(currentHomePhotoSrc);
                });
            }

            document.addEventListener('fullscreenchange', updateHomeFullscreenBtn);
            document.addEventListener('webkitfullscreenchange', updateHomeFullscreenBtn);
            document.addEventListener('mozfullscreenchange', updateHomeFullscreenBtn);
            document.addEventListener('MSFullscreenChange', updateHomeFullscreenBtn);

            homeModal.addEventListener('click', function(e) {
                if (e.target === homeModal || e.target.classList.contains('overflow-hidden')) {
                    closeHomeLightbox();
                }
            });

            document.addEventListener('keydown', function(e) {
                if (!homeModal.classList.contains('active')) return;
                if (e.key === 'Escape') closeHomeLightbox();
                if (e.key === 'ArrowRight') showNextHomePhoto();
                if (e.key === 'ArrowLeft') showPrevHomePhoto();
            });

            let touchStartX = 0;
            let touchEndX = 0;
            homeModal.addEventListener('touchstart', e => {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            homeModal.addEventListener('touchend', e => {
                touchEndX = e.changedTouches[0].screenX;
                if (touchStartX - touchEndX > 50) showNextHomePhoto();
                else if (touchEndX - touchStartX > 50) showPrevHomePhoto();
            }, { passive: true });
        })();
    </script>

    <!-- Floating Mobile-Style Bottom Navigation Bar (Results & Gallery) -->
    {{> bottomNav}}
</body>

</html>