    <script>
            (function () {
                let comps = [];
                try {
                    const rawJson = document.getElementById('festflow-competitions-data')?.textContent;
                    comps = rawJson ? JSON.parse(rawJson) : [];
                } catch (e) {
                    console.error('Error parsing festflow competitions JSON:', e);
                }

                const catSelect = document.getElementById('find-result-category');
                const compSelect = document.getElementById('find-result-competition');

                if (!catSelect || !compSelect) return;

                const PREDEFINED_CATEGORIES = [
                    'Alpha Zone',
                    'Core Zone',
                    'Prime Zone',
                    'General'
                ];

                // Strictly populate the exact predefined categories list
                catSelect.innerHTML = '<option value="">All categories</option>';
                PREDEFINED_CATEGORIES.forEach(cat => {
                    const opt = document.createElement('option');
                    opt.value = cat;
                    opt.textContent = cat;
                    catSelect.appendChild(opt);
                });

                function matchesCategory(compCategory, targetCategory) {
                    if (!compCategory || !targetCategory) return false;
                    const c = String(compCategory).toLowerCase().trim();
                    const t = String(targetCategory).toLowerCase().trim();

                    if (c === t) return true;
                    if (t.includes('alpha') && c.includes('alpha')) return true;
                    if (t.includes('core') && c.includes('core')) return true;
                    if (t.includes('prime') && c.includes('prime')) return true;
                    if (t.includes('general') && c.includes('general')) return true;
                    return c.includes(t) || t.includes(c);
                }

                function populateCompetitions(filteredComps) {
                    compSelect.innerHTML = '<option value="">All competitions</option>';
                    if (!filteredComps || filteredComps.length === 0) {
                        const opt = document.createElement('option');
                        opt.value = '';
                        opt.textContent = 'No competitions in this category';
                        opt.disabled = true;
                        compSelect.appendChild(opt);
                        return;
                    }
                    filteredComps.forEach(comp => {
                        const opt = document.createElement('option');
                        opt.value = comp.id || '';
                        const codeStr = comp.formattedCode ? `#${comp.formattedCode} - ` : '';
                        opt.textContent = `${codeStr}${comp.title}`;
                        compSelect.appendChild(opt);
                    });
                }

                // Initial populate
                populateCompetitions(comps);

                // On category change
                catSelect.addEventListener('change', function () {
                    const selectedCat = this.value;
                    if (!selectedCat) {
                        populateCompetitions(comps);
                    } else {
                        const filtered = comps.filter(c => matchesCategory(c.category, selectedCat));
                        populateCompetitions(filtered);
                    }
                });
            })();

        function navigateToSelectedResult() {
            const compId = document.getElementById('find-result-competition')?.value;
            const cat = document.getElementById('find-result-category')?.value;

            if (compId) {
                window.location.href = `/result?id=${encodeURIComponent(compId)}`;
            } else if (cat) {
                window.location.href = `/result?category=${encodeURIComponent(cat)}`;
            } else {
                window.location.href = `/result`;
            }
        }
    </script>

