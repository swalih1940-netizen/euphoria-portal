    <!-- Custom Sahityotsav Aesthetics Styling & Custom Font Definition -->
    <style>
        @font-face {
            font-family: 'TraditionalCivilization';
            src: url('/Font/Traditional%20Civilization%20Demo.ttf') format('truetype'),
                url('/Font/Traditional Civilization Demo.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        .font-custom-heading {
            font-family: 'TraditionalCivilization', 'Outfit', 'Inter', sans-serif;
        }

        /* Hero Heading Euphoria Custom Font & Organic Floating Letter Animation */
        @keyframes floatBounceA {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }

            50% {
                transform: translateY(-14px) rotate(-1.5deg);
            }
        }

        @keyframes floatBounceB {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }

            45% {
                transform: translateY(-18px) rotate(2deg);
            }
        }

        @keyframes floatBounceC {

            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }

            55% {
                transform: translateY(-10px) rotate(-1deg);
            }
        }

        .hero-heading-euphoria {
            font-family: 'TraditionalCivilization', 'Outfit', 'Inter', sans-serif;
            color: #ffffff;
            display: block;
            width: 100%;
            max-width: 100%;
            margin-left: auto;
            margin-right: auto;
            text-align: center;
            font-size: clamp(3rem, 14vw, 6.5rem);
            line-height: 1.1;
            box-sizing: border-box;
            text-shadow: none;
            filter: none;
        }

        .hero-heading-euphoria .letter {
            display: inline-block;
            color: #ffffff;
            -webkit-text-fill-color: #ffffff;
            text-shadow: none;
            transition: color 0.3s ease-in-out, -webkit-text-fill-color 0.3s ease-in-out;
            cursor: pointer;
            will-change: transform;
        }

        /* Randomized Organic Floating & Bouncing Delays, Durations & Animations */
        .hero-heading-euphoria .letter-1 {
            animation: floatBounceA 3.2s ease-in-out infinite 0s;
        }

        .hero-heading-euphoria .letter-2 {
            animation: floatBounceB 2.8s ease-in-out infinite 0.3s;
        }

        .hero-heading-euphoria .letter-3 {
            animation: floatBounceC 3.5s ease-in-out infinite 0.7s;
        }

        .hero-heading-euphoria .letter-4 {
            animation: floatBounceA 3.0s ease-in-out infinite 0.2s;
        }

        .hero-heading-euphoria .letter-5 {
            animation: floatBounceB 3.4s ease-in-out infinite 0.5s;
        }

        .hero-heading-euphoria .letter-6 {
            animation: floatBounceC 2.7s ease-in-out infinite 0.1s;
        }

        .hero-heading-euphoria .letter-7 {
            animation: floatBounceA 3.3s ease-in-out infinite 0.6s;
        }

        .hero-heading-euphoria .letter-8 {
            animation: floatBounceB 2.9s ease-in-out infinite 0.4s;
        }

        /* Targeted Hover: Only the specific hovered letter changes color */
        .hero-heading-euphoria .letter-1:hover {
            color: #06b6d4;
            -webkit-text-fill-color: #06b6d4;
        }

        .hero-heading-euphoria .letter-2:hover {
            color: #8b5cf6;
            -webkit-text-fill-color: #8b5cf6;
        }

        .hero-heading-euphoria .letter-3:hover {
            color: #ec4899;
            -webkit-text-fill-color: #ec4899;
        }

        .hero-heading-euphoria .letter-4:hover {
            color: #f43f5e;
            -webkit-text-fill-color: #f43f5e;
        }

        .hero-heading-euphoria .letter-5:hover {
            color: #f59e0b;
            -webkit-text-fill-color: #f59e0b;
        }

        .hero-heading-euphoria .letter-6:hover {
            color: #10b981;
            -webkit-text-fill-color: #10b981;
        }

        .hero-heading-euphoria .letter-7:hover {
            color: #38bdf8;
            -webkit-text-fill-color: #38bdf8;
        }

        .hero-heading-euphoria .letter-8:hover {
            color: #a855f7;
            -webkit-text-fill-color: #a855f7;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(11, 17, 32, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.07);
        }

        .glass-nav {
            background: rgba(7, 10, 18, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .gradient-text-gold {
            background: linear-gradient(135deg, #fef08a 0%, #f59e0b 50%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gradient-text-vibrant {
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #94a3b8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .bg-grid-mesh {
            background-image: radial-gradient(rgba(245, 158, 11, 0.12) 1px, transparent 1px);
            background-size: 32px 32px;
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #070a12;
        }

        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #f59e0b;
        }

        /* Clean sharp corners for home gallery cards */
        .home-gallery-card {
            border-radius: 0 !important;
        }

        /* Smooth Lightbox fade */
        #home-lightbox-modal {
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }
        #home-lightbox-modal.active {
            opacity: 1;
            visibility: visible;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body
    class="bg-[#070a12] text-slate-100 font-sans antialiased selection:bg-amber-500 selection:text-slate-950 overflow-x-hidden">

    <!-- Navbar: Logo (Left), Live Countdown (Middle), Results Button (Right) -->
