                    <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                </span>
                <span
                    class="hidden md:inline text-[10px] font-bold text-amber-400/90 uppercase tracking-wider mr-0.5">Countdown:</span>
