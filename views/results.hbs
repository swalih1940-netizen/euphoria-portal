        function downloadCompetitionResult(id) {
            printCompetitionResult(id);
        }

        function shareCompetitionResult(id, title, btnElement) {
            return shareCompetitionWhatsApp(id, btnElement);
        }

        let cachedPosterBgDataUrl = null;
        let cachedPoster2BgDataUrl = null;
        let cachedFontEmbedCss = null;

        // Track selected poster variant per card (default is 1)
        const cardSelectedVariants = {};
        let activeModalPoster = { compId: '', variant: 1, dataUrl: '', filename: '', compTitle: '' };

        function setCardPosterVariant(compId, variant, btnElement) {
            const v = parseInt(variant, 10) === 2 ? 2 : 1;
            cardSelectedVariants[compId] = v;

            const btn1 = document.getElementById(`var-btn-1-${compId}`);
            const btn2 = document.getElementById(`var-btn-2-${compId}`);

            if (btn1 && btn2) {
                if (v === 1) {
                    btn1.className = 'card-var-btn px-2 sm:px-2.5 py-1 rounded text-[10px] sm:text-xs font-bold transition-all bg-amber-400 text-slate-950 shadow-sm';
                    btn2.className = 'card-var-btn px-2 sm:px-2.5 py-1 rounded text-[10px] sm:text-xs font-bold transition-all text-slate-400 hover:text-white';
                } else {
                    btn1.className = 'card-var-btn px-2 sm:px-2.5 py-1 rounded text-[10px] sm:text-xs font-bold transition-all text-slate-400 hover:text-white';
                    btn2.className = 'card-var-btn px-2 sm:px-2.5 py-1 rounded text-[10px] sm:text-xs font-bold transition-all bg-amber-400 text-slate-950 shadow-sm';
                }
            }
        }

        function getCardPosterVariant(compId) {
            return cardSelectedVariants[compId] || 1;
        }

        async function preparePosterAssets(variant = 1) {
            const v = parseInt(variant, 10) === 2 ? 2 : 1;

            if (v === 1 && !cachedPosterBgDataUrl) {
                try {
                    const res = await fetch('/images/Result.jpg');
                    const blob = await res.blob();
                    cachedPosterBgDataUrl = await new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onloadend = () => resolve(reader.result);
                        reader.onerror = reject;
                        reader.readAsDataURL(blob);
                    });
                } catch (e) {
                    console.warn('[Poster Engine] Could not pre-load Result.jpg as base64 data URL:', e);
                }
            }

            if (v === 2 && !cachedPoster2BgDataUrl) {
                try {
                    const res = await fetch('/images/2nd-Poster-Mian.jpg');
                    const blob = await res.blob();
                    cachedPoster2BgDataUrl = await new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onloadend = () => resolve(reader.result);
                        reader.onerror = reject;
                        reader.readAsDataURL(blob);
                    });
                } catch (e) {
                    console.warn('[Poster Engine] Could not pre-load 2nd-Poster-Mian.jpg as base64 data URL:', e);
                }
            }

            if (!cachedFontEmbedCss) {
                try {
                    const fontUrls = [
                        { family: 'Nohemi-Light', weight: 300, format: 'opentype', url: '/Font/Poster Font/Nohemi-Light-BF6438cc583f70b.otf' },
                        { family: 'Nohemi-Regular', weight: 400, format: 'opentype', url: '/Font/Poster Font/Nohemi-Regular-BF6438cc58b98fc.otf' },
                        { family: 'Nohemi-SemiBold', weight: 600, format: 'truetype', url: '/Font/Poster Font/Nohemi-SemiBold-BF6438cc588a48a.ttf' }
                    ];

                    let css = '';
                    for (const font of fontUrls) {
                        try {
                            const res = await fetch(font.url);
                            const blob = await res.blob();
                            const dataUrl = await new Promise((resolve, reject) => {
                                const reader = new FileReader();
                                reader.onloadend = () => resolve(reader.result);
                                reader.onerror = reject;
                                reader.readAsDataURL(blob);
                            });
                            css += `@font-face { font-family: '${font.family}'; src: url('${dataUrl}') format('${font.format}'); font-weight: ${font.weight}; font-style: normal; }\n`;
                        } catch (fontErr) {
                            console.warn(`[Poster Engine] Failed embedding font ${font.family}:`, fontErr);
                        }
                    }
                    cachedFontEmbedCss = css;
                } catch (e) {
                    console.warn('[Poster Engine] Could not pre-embed poster fonts:', e);
                }
            }
        }

        // Helper to normalize and sort winners supporting ties and arbitrary counts
        function normalizeAndSortPosterWinners(rawWinners) {
            if (!Array.isArray(rawWinners)) return [];
            const list = rawWinners.map((w, idx) => {
                let rank = 1;
                const rStr = String(w.rank !== undefined ? w.rank : (w.position !== undefined ? w.position : (w.prize || ''))).toLowerCase().trim();
                if (w.rank !== undefined && !isNaN(parseInt(w.rank, 10)) && parseInt(w.rank, 10) > 0) {
                    rank = parseInt(w.rank, 10);
                } else if (rStr.includes('1st') || rStr === '1' || rStr.includes('first')) {
                    rank = 1;
                } else if (rStr.includes('2nd') || rStr === '2' || rStr.includes('second')) {
                    rank = 2;
                } else if (rStr.includes('3rd') || rStr === '3' || rStr.includes('third')) {
                    rank = 3;
                } else {
                    const match = rStr.match(/\d+/);
                    rank = match ? parseInt(match[0], 10) : (idx + 1);
                }

                const name = (w.participant || w.participantName || w.name || w.candidateName || w.studentName || '').trim();
                const team = (w.team || w.teamName || w.rawTeamName || w.displayTeam || '').trim();
                const prize = (w.prize || (rank === 1 ? '1st' : rank === 2 ? '2nd' : rank === 3 ? '3rd' : `${rank}th`)).trim();

                return {
                    ...w,
                    rank: rank > 0 ? rank : (idx + 1),
                    prize,
                    participant: name || 'Participant',
                    team: team || '-'
                };
            });

            // Filter out empty rows and keep strictly top 3 position winners (1st, 2nd, and 3rd place only)
            const valid = list.filter(w => w.participant && w.participant !== '-' && w.rank >= 1 && w.rank <= 3);
            // Sort ascending by rank (1st -> 2nd -> 3rd)
            valid.sort((a, b) => a.rank - b.rank);
            return valid;
        }

        function escapePosterHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function getPoster2StarSvg(fill, size = 34) {
            return `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="${fill}" style="display:inline-block; flex-shrink: 0;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
        }

        function renderPoster2StarsHtml(rank, starSize = 34, gap = 10) {
            const white = '#ffffff';
            const grey = '#475569';
            let stars = '';
            if (rank === 1) {
                stars = getPoster2StarSvg(white, starSize) + getPoster2StarSvg(white, starSize) + getPoster2StarSvg(white, starSize);
            } else if (rank === 2) {
                stars = getPoster2StarSvg(white, starSize) + getPoster2StarSvg(white, starSize) + getPoster2StarSvg(grey, starSize);
            } else if (rank === 3) {
                stars = getPoster2StarSvg(white, starSize) + getPoster2StarSvg(grey, starSize) + getPoster2StarSvg(grey, starSize);
            } else {
                stars = getPoster2StarSvg(grey, starSize) + getPoster2StarSvg(grey, starSize) + getPoster2StarSvg(grey, starSize);
            }
            return `<div style="display: flex; align-items: center; gap: ${gap}px;">${stars}</div>`;
        }

        async function generateCompetitionPoster(compId, variant = 1) {
            const v = parseInt(variant, 10) === 2 ? 2 : 1;
            const rawCompsData = document.getElementById('competitions-json-data')?.textContent;
            let compList = [];
            try {
                compList = rawCompsData ? JSON.parse(rawCompsData) : [];
            } catch (e) {
                console.error('Error parsing competitions JSON data:', e);
            }

            const comp = compList.find(c => String(c.id) === String(compId)) || compList.find(c => String(c.code) === String(compId));
            if (!comp) {
                throw new Error('Competition details not found for poster export.');
            }

            const wrapperElem = v === 2
                ? document.getElementById('poster-render-wrapper-2')
                : (document.getElementById('poster-render-wrapper') || document.getElementById('poster-render-wrapper-1'));
            const cardElem = v === 2
                ? document.getElementById('poster-render-card-2')
                : (document.getElementById('poster-render-card') || document.getElementById('poster-render-card-1'));

            try {
                // Pre-load assets as Base64 Data URLs to avoid CORS and fetch failures
                await preparePosterAssets(v);

                // Format Result Number
                let resNum = comp.formattedCode || comp.code || comp.resultNumber || '01';
                resNum = String(resNum).trim();
                if (/^\d+$/.test(resNum) && resNum.length < 2) {
                    resNum = resNum.padStart(2, '0');
                }

                // Competition Title
                const compTitle = comp.title || comp.name || 'Competition';

                // Extract all winners (including ties, multiple 1st/2nd/3rd places, or 4+ candidates)
                const winnersList = normalizeAndSortPosterWinners(comp.winners);
                const winnerCount = winnersList.length;

                if (v === 1) {
                    // Populate Variant 1 DOM elements
                    const bgImgElem = document.getElementById('poster-1-bg-img') || cardElem.querySelector('img');
                    if (bgImgElem && cachedPosterBgDataUrl) {
                        bgImgElem.src = cachedPosterBgDataUrl;
                    }

                    const stdWinners1 = document.getElementById('poster1-standard-winners');
                    const dynWinners1 = document.getElementById('poster1-dynamic-container');
                    const circleCover1 = document.getElementById('poster1-circle-cover');

                    if (winnerCount >= 4) {
                        // MULTI-WINNER DYNAMIC LAYOUT (4 or more candidates/winners e.g. ties or multiple prizes)
                        if (stdWinners1) stdWinners1.style.display = 'none';
                        if (circleCover1) circleCover1.style.display = 'block';
                        if (dynWinners1) {
                            dynWinners1.style.display = 'flex';

                            const N = winnerCount;
                            let nameFontSize = 62;
                            let teamFontSize = 38;
                            let badgeSize = 78;
                            let badgeFontSize = 34;
                            let marginBetween = 4;

                            if (N === 4) {
                                nameFontSize = 62;
                                teamFontSize = 38;
                                badgeSize = 78;
                                badgeFontSize = 34;
                                marginBetween = 4;
                            } else if (N === 5) {
                                nameFontSize = 52;
                                teamFontSize = 32;
                                badgeSize = 68;
                                badgeFontSize = 30;
                                marginBetween = 3;
                            } else if (N === 6) {
                                nameFontSize = 42;
                                teamFontSize = 26;
                                badgeSize = 58;
                                badgeFontSize = 25;
                                marginBetween = 2;
                            } else {
                                nameFontSize = Math.max(28, Math.floor(250 / N));
                                teamFontSize = Math.max(18, Math.floor(160 / N));
                                badgeSize = Math.max(46, Math.floor(350 / N));
                                badgeFontSize = Math.max(20, Math.floor(155 / N));
                                marginBetween = 2;
                            }

                            dynWinners1.innerHTML = winnersList.map(w => {
                                let borderColor = '#64748b';
                                let textColor = '#cbd5e1';
                                if (w.rank === 1) {
                                    borderColor = '#FFC700';
                                    textColor = '#FFC700';
                                } else if (w.rank === 2) {
                                    borderColor = '#cbd5e1';
                                    textColor = '#ffffff';
                                } else if (w.rank === 3) {
                                    borderColor = '#f59e0b';
                                    textColor = '#fbbf24';
                                }
                                const badgeText = String(w.rank).padStart(2, '0');

                                return `
                                <div style="display: flex; align-items: center; width: 100%; min-height: 0;">
                                    <div style="width: 188px; min-width: 188px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                        <div style="width: ${badgeSize}px; height: ${badgeSize}px; border-radius: 50%; border: 3px solid ${borderColor}; background: #0b0d14; display: flex; align-items: center; justify-content: center; font-family: 'Nohemi-SemiBold', sans-serif; font-size: ${badgeFontSize}px; font-weight: 600; color: ${textColor}; box-shadow: 0 4px 16px rgba(0,0,0,0.6);">
                                            ${badgeText}
                                        </div>
                                    </div>
                                    <div style="flex: 1; min-width: 0; padding-left: 6px;">
                                        <div style="font-family: 'Nohemi-Regular', sans-serif; font-size: ${nameFontSize}px; font-weight: 400; color: #ffffff; line-height: 1.1; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            ${escapePosterHtml(w.participant)}
                                        </div>
                                        <div style="font-family: 'Nohemi-Regular', sans-serif; font-size: ${teamFontSize}px; font-weight: 400; color: #ffffff; margin-top: ${marginBetween}px; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            ${escapePosterHtml(w.team)}
                                        </div>
                                    </div>
                                </div>`;
                            }).join('');
                        }
                    } else {
                        // STANDARD 3-WINNER LAYOUT (<= 3 winners)
                        if (circleCover1) circleCover1.style.display = 'none';
                        if (dynWinners1) dynWinners1.style.display = 'none';
                        if (stdWinners1) stdWinners1.style.display = 'block';

                        const w1 = winnersList[0];
                        const w2 = winnersList[1];
                        const w3 = winnersList[2];

                        const row1 = document.getElementById('poster-winner-1');
                        if (w1) {
                            row1.style.display = 'block';
                            document.getElementById('poster-p1-name').innerText = w1.participant || '-';
                            document.getElementById('poster-t1-name').innerText = w1.team || '-';
                        } else {
                            row1.style.display = 'none';
                        }

                        const row2 = document.getElementById('poster-winner-2');
                        if (w2) {
                            row2.style.display = 'block';
                            document.getElementById('poster-p2-name').innerText = w2.participant || '-';
                            document.getElementById('poster-t2-name').innerText = w2.team || '-';
                        } else {
                            row2.style.display = 'none';
                        }

                        const row3 = document.getElementById('poster-winner-3');
                        if (w3) {
                            row3.style.display = 'block';
                            document.getElementById('poster-p3-name').innerText = w3.participant || '-';
                            document.getElementById('poster-t3-name').innerText = w3.team || '-';
                        } else {
                            row3.style.display = 'none';
                        }
                    }

                    document.getElementById('poster-res-num').innerText = resNum;

                    // Category / Zone Subheading
                    let compCategory = comp.category || comp.categoryName || comp.catName || comp.stageCategory || 'GENERAL';
                    if (typeof compCategory === 'object') {
                        compCategory = compCategory.name || compCategory.title || compCategory.label || 'GENERAL';
                    }
                    compCategory = String(compCategory).trim().toUpperCase();
                    if (compCategory === 'PRIME') compCategory = 'PRIME ZONE';
                    if (compCategory === 'CORE') compCategory = 'CORE ZONE';
                    if (compCategory === 'ALPHA') compCategory = 'ALPHA ZONE';

                    const catElem = document.getElementById('poster-comp-category');
                    if (catElem) catElem.innerText = compCategory;

                    const titleElem = document.getElementById('poster-comp-title');
                    if (titleElem) {
                        titleElem.innerText = compTitle;
                        if (compTitle.length > 24) {
                            titleElem.style.fontSize = '84px';
                            titleElem.style.lineHeight = '1.14';
                        } else if (compTitle.length > 14) {
                            titleElem.style.fontSize = '96px';
                            titleElem.style.lineHeight = '1.12';
                        } else {
                            titleElem.style.fontSize = '104px';
                            titleElem.style.lineHeight = '1.1';
                        }
                    }
                } else {
                    // Populate Variant 2 (Anchor Edition) DOM elements
                    const bgImgElem2 = document.getElementById('poster-2-bg-img') || cardElem.querySelector('img');
                    if (bgImgElem2 && cachedPoster2BgDataUrl) {
                        bgImgElem2.src = cachedPoster2BgDataUrl;
                    }

                    // Result Number
                    const numElem2 = document.getElementById('poster2-res-num');
                    if (numElem2) numElem2.innerText = resNum;

                    // Competition Title
                    const titleElem2 = document.getElementById('poster2-comp-title');
                    if (titleElem2) {
                        titleElem2.innerText = compTitle;
                        if (compTitle.length > 28) {
                            titleElem2.style.fontSize = '58px';
                            titleElem2.style.lineHeight = '1.1';
                        } else if (compTitle.length > 18) {
                            titleElem2.style.fontSize = '68px';
                            titleElem2.style.lineHeight = '1.1';
                        } else {
                            titleElem2.style.fontSize = '80px';
                            titleElem2.style.lineHeight = '1.12';
                        }
                    }

                    const stdWinners2 = document.getElementById('poster2-standard-winners');
                    const dynWinners2 = document.getElementById('poster2-dynamic-container');

                    if (winnerCount >= 4) {
                        // MULTI-WINNER DYNAMIC LAYOUT (4 or more candidates/winners)
                        if (stdWinners2) stdWinners2.style.display = 'none';
                        if (dynWinners2) {
                            dynWinners2.style.display = 'flex';

                            const N = winnerCount;
                            let nameFontSize = 58;
                            let teamFontSize = 36;
                            let starSize = 28;
                            let starGap = 8;
                            let starMarginBottom = 10;
                            let marginBetween = 4;

                            if (N === 4) {
                                nameFontSize = 58;
                                teamFontSize = 36;
                                starSize = 28;
                                starGap = 8;
                                starMarginBottom = 10;
                                marginBetween = 4;
                            } else if (N === 5) {
                                nameFontSize = 48;
                                teamFontSize = 30;
                                starSize = 23;
                                starGap = 7;
                                starMarginBottom = 8;
                                marginBetween = 3;
                            } else if (N === 6) {
                                nameFontSize = 40;
                                teamFontSize = 25;
                                starSize = 19;
                                starGap = 6;
                                starMarginBottom = 6;
                                marginBetween = 2;
                            } else {
                                nameFontSize = Math.max(28, Math.floor(250 / N));
                                teamFontSize = Math.max(18, Math.floor(160 / N));
                                starSize = Math.max(15, Math.floor(120 / N));
                                starGap = 5;
                                starMarginBottom = 5;
                                marginBetween = 2;
                            }

                            dynWinners2.innerHTML = winnersList.map(w => {
                                const starsHtml = renderPoster2StarsHtml(w.rank, starSize, starGap);
                                return `
                                <div style="width: 100%; min-height: 0;">
                                    <div style="margin-bottom: ${starMarginBottom}px;">
                                        ${starsHtml}
                                    </div>
                                    <div style="font-family: 'Nohemi-Regular', sans-serif; font-size: ${nameFontSize}px; font-weight: 400; color: #ffffff; line-height: 1.1; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        ${escapePosterHtml(w.participant)}
                                    </div>
                                    <div style="font-family: 'Nohemi-Regular', sans-serif; font-size: ${teamFontSize}px; font-weight: 400; color: #e2e8f0; margin-top: ${marginBetween}px; line-height: 1.1; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        ${escapePosterHtml(w.team)}
                                    </div>
                                </div>`;
                            }).join('');
                        }
                    } else {
                        // STANDARD 3-WINNER LAYOUT (<= 3 winners)
                        if (dynWinners2) dynWinners2.style.display = 'none';
                        if (stdWinners2) stdWinners2.style.display = 'block';

                        const w1 = winnersList[0];
                        const w2 = winnersList[1];
                        const w3 = winnersList[2];

                        const row1 = document.getElementById('poster2-winner-1');
                        if (w1) {
                            row1.style.display = 'block';
                            document.getElementById('poster2-p1-name').innerText = w1.participant || '-';
                            document.getElementById('poster2-t1-name').innerText = w1.team || '-';
                            const stars1 = document.getElementById('poster2-stars-1');
                            if (stars1) stars1.innerHTML = renderPoster2StarsHtml(w1.rank, 34, 10);
                        } else {
                            row1.style.display = 'none';
                        }

                        const row2 = document.getElementById('poster2-winner-2');
                        if (w2) {
                            row2.style.display = 'block';
                            document.getElementById('poster2-p2-name').innerText = w2.participant || '-';
                            document.getElementById('poster2-t2-name').innerText = w2.team || '-';
                            const stars2 = document.getElementById('poster2-stars-2');
                            if (stars2) stars2.innerHTML = renderPoster2StarsHtml(w2.rank, 34, 10);
                        } else {
                            row2.style.display = 'none';
                        }

                        const row3 = document.getElementById('poster2-winner-3');
                        if (w3) {
                            row3.style.display = 'block';
                            document.getElementById('poster2-p3-name').innerText = w3.participant || '-';
                            document.getElementById('poster2-t3-name').innerText = w3.team || '-';
                            const stars3 = document.getElementById('poster2-stars-3');
                            if (stars3) stars3.innerHTML = renderPoster2StarsHtml(w3.rank, 34, 10);
                        } else {
                            row3.style.display = 'none';
                        }
                    }
                }

                // Make poster wrapper visible to browser layout engine during capture
                if (wrapperElem) {
                    wrapperElem.style.opacity = '1';
                    wrapperElem.style.zIndex = '99999';
                    wrapperElem.style.left = '0';
                    wrapperElem.style.top = '0';
                }

                if (document.fonts && document.fonts.ready) {
                    await document.fonts.ready;
                }

                // Resolve html-to-image toPng engine
                const getEngine = () => {
                    if (window.htmlToImage && typeof window.htmlToImage.toPng === 'function') {
                        return window.htmlToImage;
                    }
                    if (typeof htmlToImage !== 'undefined' && typeof htmlToImage.toPng === 'function') {
                        return htmlToImage;
                    }
                    return null;
                };

                let renderEngine = getEngine();
                if (!renderEngine) {
                    await new Promise((resolve) => {
                        const s = document.createElement('script');
                        s.src = '/js/html-to-image.js';
                        s.onload = resolve;
                        s.onerror = resolve;
                        document.head.appendChild(s);
                    });
                    renderEngine = getEngine();
                }

                if (!renderEngine || typeof renderEngine.toPng !== 'function') {
                    throw new Error('html-to-image render engine is not loaded');
                }

                const toPng = renderEngine.toPng.bind(renderEngine);
                const width = v === 2 ? 2000 : 2480;
                const height = v === 2 ? 2500 : 2953;

                const options = {
                    width: width,
                    height: height,
                    pixelRatio: 1,
                    cacheBust: true
                };

                if (cachedFontEmbedCss) {
                    options.fontEmbedCSS = cachedFontEmbedCss;
                }

                // Warmup pass to prime canvas rendering engine
                try {
                    await toPng(cardElem, options);
                } catch (e) { }

                // Capture high-res PNG image
                const dataUrl = await toPng(cardElem, options);
                const cleanName = compTitle.replace(/[^a-zA-Z0-9\s]/g, '').trim().replace(/\s+/g, '_');
                const filename = `Result_#${resNum}_${cleanName}${v === 2 ? '_v2' : ''}.png`;

                return {
                    comp,
                    compTitle,
                    resNum,
                    filename,
                    dataUrl,
                    variant: v
                };
            } finally {
                // Restore poster wrapper hidden state
                if (wrapperElem) {
                    wrapperElem.style.opacity = '0';
                    wrapperElem.style.zIndex = '-99999';
                    wrapperElem.style.left = '-9999px';
                }
            }
        }

        function formatWhatsAppCaption(comp, compTitle, resNum, variant = 1) {
            let num = resNum || comp.formattedCode || comp.code || comp.resultNumber || '01';
            num = String(num).trim();
            if (/^\d+$/.test(num) && num.length < 2) {
                num = num.padStart(2, '0');
            }

            const title = compTitle || comp.title || comp.name || 'Competition';
            const compId = comp.id || comp._id || '';
            const shareUrl = compId ? `${window.location.origin}/result?id=${encodeURIComponent(compId)}` : `${window.location.origin}/result`;

            return `*EUPHORIA 2K26*\n${title} | Result #${num}\n\n🔗 ${shareUrl}`;
        }

        function openPosterPreviewModal(dataUrl, filename, compTitle, compId, variant = 1) {
            activeModalPoster = { compId, variant, dataUrl, filename, compTitle };
            const modal = document.getElementById('poster-preview-modal');
            const img = document.getElementById('preview-modal-img');
            const title = document.getElementById('preview-modal-title');

            const modalBtn1 = document.getElementById('modal-var-1-btn');
            const modalBtn2 = document.getElementById('modal-var-2-btn');
            if (modalBtn1 && modalBtn2) {
                if (variant === 2) {
                    modalBtn1.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all text-slate-400 hover:text-white';
                    modalBtn2.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all bg-amber-400 text-slate-950 shadow-sm';
                } else {
                    modalBtn1.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all bg-amber-400 text-slate-950 shadow-sm';
                    modalBtn2.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all text-slate-400 hover:text-white';
                }
            }

            if (modal && img) {
                img.src = dataUrl;
                if (title) title.innerText = compTitle ? compTitle.trim() : 'Competition Result';
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
            }
        }

        async function switchModalPosterVariant(variant) {
            const v = parseInt(variant, 10) === 2 ? 2 : 1;
            if (activeModalPoster.variant === v && activeModalPoster.dataUrl) return;

            const modalBtn1 = document.getElementById('modal-var-1-btn');
            const modalBtn2 = document.getElementById('modal-var-2-btn');
            if (modalBtn1 && modalBtn2) {
                if (v === 1) {
                    modalBtn1.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all bg-amber-400 text-slate-950 shadow-sm';
                    modalBtn2.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all text-slate-400 hover:text-white';
                } else {
                    modalBtn1.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all text-slate-400 hover:text-white';
                    modalBtn2.className = 'px-2.5 py-1 rounded text-xs font-bold transition-all bg-amber-400 text-slate-950 shadow-sm';
                }
            }

            if (!activeModalPoster.compId) return;

            const img = document.getElementById('preview-modal-img');
            if (img) img.style.opacity = '0.5';

            try {
                const res = await generateCompetitionPoster(activeModalPoster.compId, v);
                activeModalPoster.variant = v;
                activeModalPoster.dataUrl = res.dataUrl;
                activeModalPoster.filename = res.filename;
                activeModalPoster.compTitle = res.compTitle;

                if (img) {
                    img.src = res.dataUrl;
                    img.style.opacity = '1';
                }

                // Synchronize selection back to the card button
                setCardPosterVariant(activeModalPoster.compId, v);
            } catch (err) {
                console.error('[Modal Switch Variant Error]:', err);
                if (img) img.style.opacity = '1';
                alert(`Could not generate Poster Design ${v}: ${err.message || 'Unknown error'}`);
            }
        }

        function downloadPosterFromModal() {
            if (!activeModalPoster || !activeModalPoster.dataUrl) return;

            try {
                const link = document.createElement('a');
                link.download = activeModalPoster.filename || 'Euphoria-Result-Poster.png';
                link.href = activeModalPoster.dataUrl;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } catch (err) {
                console.error('[Modal Poster Download Error]:', err);
            }
        }

        async function sharePosterFromModal() {
            if (!activeModalPoster || !activeModalPoster.compId) return;
            const btn = document.getElementById('preview-modal-share-btn');
            await shareCompetitionWhatsApp(activeModalPoster.compId, btn, activeModalPoster.variant);
        }

        function closePosterPreviewModal() {
            const modal = document.getElementById('poster-preview-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.classList.remove('overflow-hidden');
            }
        }

        // Close modal on Escape key press
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closePosterPreviewModal();
            }
        });

        async function downloadCompetitionPoster(compId, btnElement, variant) {
            const v = variant ? parseInt(variant, 10) : getCardPosterVariant(compId);
            const originalBtnHtml = btnElement ? btnElement.innerHTML : '';
            if (btnElement) {
                btnElement.disabled = true;
                btnElement.classList.add('opacity-75', 'cursor-wait');
                btnElement.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Generating...</span>`;
            }

            try {
                const { compTitle, filename, dataUrl } = await generateCompetitionPoster(compId, v);
                openPosterPreviewModal(dataUrl, filename, compTitle, compId, v);
            } catch (err) {
                console.error('[Poster Generation Error Details]:', err);
                if (err && err.stack) console.error('Stack trace:', err.stack);
                alert(`Could not generate poster image: ${err.message || 'Unknown error'}`);
            } finally {
                if (btnElement) {
                    btnElement.disabled = false;
                    btnElement.classList.remove('opacity-75', 'cursor-wait');
                    btnElement.innerHTML = originalBtnHtml;
                }
            }
        }

        async function shareCompetitionWhatsApp(compId, btnElement, variant) {
            const v = variant ? parseInt(variant, 10) : getCardPosterVariant(compId);
            const originalBtnHtml = btnElement ? btnElement.innerHTML : '';
            if (btnElement) {
                btnElement.disabled = true;
                btnElement.classList.add('opacity-75', 'cursor-wait');
                btnElement.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">sync</span><span>Generating...</span>`;
            }

            try {
                const { comp, compTitle, resNum, filename, dataUrl } = await generateCompetitionPoster(compId, v);
                const captionText = formatWhatsAppCaption(comp, compTitle, resNum, v);

                const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                let sharedViaWebShare = false;

                // Try Web Share API with image file on supported mobile browsers
                if (isMobile && navigator.canShare) {
                    try {
                        const blobRes = await fetch(dataUrl);
                        const blob = await blobRes.blob();
                        const posterFile = new File([blob], filename, { type: 'image/png' });

                        if (navigator.canShare({ files: [posterFile] })) {
                            await navigator.share({
                                files: [posterFile],
                                title: `Euphoria 2k26 - ${compTitle}`,
                                text: captionText
                            });
                            sharedViaWebShare = true;
                        }
                    } catch (shareErr) {
                        if (shareErr.name === 'AbortError') {
                            return;
                        }
                        console.warn('[Web Share API failed, falling back to direct WhatsApp]:', shareErr);
                    }
                }

                // If not mobile Web Share with image, directly open WhatsApp with pre-formatted caption & download poster
                if (!sharedViaWebShare) {
                    const link = document.createElement('a');
                    link.download = filename;
                    link.href = dataUrl;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(captionText)}`;
                    window.open(whatsappUrl, '_blank');
                }

            } catch (err) {
                console.error('[WhatsApp Share Error]:', err);
                if (err && err.stack) console.error('Stack trace:', err.stack);
                alert(`Could not share result to WhatsApp: ${err.message || 'Unknown error'}`);
            } finally {
                if (btnElement) {
                    btnElement.disabled = false;
                    btnElement.classList.remove('opacity-75', 'cursor-wait');
                    btnElement.innerHTML = originalBtnHtml;
                }
            }
        }
    </script>

    <!-- Floating Mobile-Style Bottom Navigation Bar (Results & Gallery) -->
    {{> bottomNav}}
</body>

</html>